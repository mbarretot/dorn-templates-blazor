<section
    id="playground-inspector"
    class="flex flex-col gap-4 rounded-lg border border-border bg-muted/40 p-4"
    aria-label="Inspector"
    data-testid="playground-inspector"
>
    <div>
        <p class="text-sm font-medium uppercase tracking-[0.16em] text-primary">Inspector</p>
        <h2 class="text-lg font-semibold text-foreground">Effective state</h2>
    </div>
    <dl class="grid gap-3 text-sm">
        <div class="grid gap-1">
            <dt class="text-muted-foreground">Selected component</dt>
            <dd class="font-medium text-foreground">Selected component: @Title</dd>
        </div>
        <div class="grid gap-1">
            <dt class="text-muted-foreground">Effective example</dt>
            <dd class="overflow-x-auto font-mono text-xs text-foreground">@CodeSnippet</dd>
        </div>
        <div class="grid gap-1">
            <dt class="text-muted-foreground">API entries</dt>
            <dd class="font-medium text-foreground">@ApiParameters.Count</dd>
        </div>
    </dl>
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter, EditorRequired]
    public string CodeSnippet { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<PlaygroundParameter> ApiParameters { get; set; } = [];
}
