@inherits LayoutComponentBase
@using CleanArchBlazorWasm.Web.Components.Theme

<div class="flex min-h-screen bg-background text-foreground">
    <a href="#main-content" class="sr-only focus:not-sr-only">Skip to content</a>
    @if (_navVisible)
    {
        <aside
            class="flex w-64 shrink-0 flex-col gap-6 border-r border-border p-4"
            aria-label="Main navigation"
        >
            <a href="/" class="text-lg font-semibold text-foreground">Component Observatory</a>
            <NavMenu />
        </aside>
    }
    <div class="flex flex-1 flex-col">
        <header class="flex items-center justify-between gap-3 border-b border-border px-6 py-4">
            <button
                type="button"
                class="inline-flex size-9 items-center justify-center rounded-md border border-input bg-background text-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
                aria-label="@(_navVisible ? "Hide navigation" : "Show navigation")"
                aria-pressed="@(_navVisible ? "true" : "false")"
                data-testid="nav-toggle"
                @onclick="ToggleNav"
            >
                <Icon Name="IconName.Menu" />
            </button>
            <div class="flex items-center gap-3">
                <ThemeToggle />
                <Avatar Size="AvatarSize.Sm">
                    <AvatarImage Src="images/avatar-placeholder.png" Alt="Current user" />
                    <AvatarFallback>US</AvatarFallback>
                </Avatar>
            </div>
        </header>
        <main id="main-content" tabindex="-1" class="flex-1">
            @Body
        </main>
    </div>
    <ToastHost />
</div>

@code {
    private bool _navVisible = true;

    private void ToggleNav() => _navVisible = !_navVisible;
}
