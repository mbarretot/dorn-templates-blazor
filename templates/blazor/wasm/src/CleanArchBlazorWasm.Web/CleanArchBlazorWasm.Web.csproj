<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

<!--#if (IncludeCleanArchitecture) -->
  <ItemGroup>
    <ProjectReference Include="..\CleanArchBlazorWasm.Application\CleanArchBlazorWasm.Application.csproj" />
    <ProjectReference Include="..\CleanArchBlazorWasm.Infrastructure\CleanArchBlazorWasm.Infrastructure.csproj" />
  </ItemGroup>
<!--#endif -->

  <ItemGroup>
    <!-- Sdk.BlazorWebAssembly has no ASP.NET Core shared framework, so AddHttpClient
         needs this package explicitly (Sdk.Web gets it for free). -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dorn.WebUI.Primitives" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>
</Project>
