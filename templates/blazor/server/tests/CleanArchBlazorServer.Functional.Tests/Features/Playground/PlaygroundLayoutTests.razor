@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void NavDrawerTrigger_IsHiddenAboveLargeBreakpoint()
    {
        var cut = Render<PlaygroundLayout>();

        var trigger = cut.Find("[data-testid='playground-nav-drawer-trigger']");

        Assert.Contains("lg:hidden", trigger.GetAttribute("class"));
    }

    [Fact]
    public void ClickingTrigger_OpensDrawer_AndCallsModalOpen()
    {
        var open = ModalModule.SetupVoid("open", _ => true).SetVoidResult();

        var cut = Render<PlaygroundLayout>();

        cut.Find("[data-testid='playground-nav-drawer-trigger']").Click();

        Assert.Single(open.Invocations);
    }

    [Fact]
    public void OpenDrawer_ContainsDialogTitle()
    {
        ModalModule.SetupVoid("open", _ => true).SetVoidResult();

        var cut = Render<PlaygroundLayout>();
        cut.Find("[data-testid='playground-nav-drawer-trigger']").Click();

        var drawer = cut.Find("[data-testid='playground-nav-drawer']");

        Assert.NotEmpty(drawer.QuerySelectorAll("h2"));
    }

    [Fact]
    public void DrawerMarkup_CarriesNoZIndexClass()
    {
        ModalModule.SetupVoid("open", _ => true).SetVoidResult();

        var cut = Render<PlaygroundLayout>();
        cut.Find("[data-testid='playground-nav-drawer-trigger']").Click();

        var drawer = cut.Find("[data-testid='playground-nav-drawer']");

        Assert.DoesNotMatch(@"(?:^|\s)z-\S+", drawer.GetAttribute("class"));
    }
}
