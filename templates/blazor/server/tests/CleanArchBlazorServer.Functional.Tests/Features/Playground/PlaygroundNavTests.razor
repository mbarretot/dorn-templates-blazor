@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void RendersOneCollapsibleTriggerPerCatalogCategory()
    {
        var cut = Render(@<PlaygroundNav />);

        var triggers = cut.FindAll("[data-testid^='nav-category-']");

        Assert.Equal(PlaygroundCatalog.Categories.Count, triggers.Count);
    }

    [Fact]
    public void SearchInput_RendersEmptyValue_NotTheFieldNameLiteral()
    {
        var cut = Render(@<PlaygroundNav />);

        var value = cut.Find("[data-testid='playground-nav-search']").GetAttribute("value");

        Assert.Equal("", value);
    }

    [Fact]
    public void TypingAMatchingQuery_FiltersToMatchingEntry_AndAutoExpandsItsCategory()
    {
        var cut = Render(@<PlaygroundNav />);

        cut.Find("[data-testid='playground-nav-search']").Input("button");

        var trigger = cut.Find("[data-testid='nav-category-Forms']");

        Assert.Equal("true", trigger.GetAttribute("aria-expanded"));
        Assert.Single(cut.FindAll("[data-testid='nav-entry-Button']"));
    }

    [Fact]
    public void ClearingTheQuery_RestoresAllCategories_AndCollapsesBackToDefaultState()
    {
        var cut = Render(@<PlaygroundNav />);

        cut.Find("[data-testid='playground-nav-search']").Input("button");
        cut.Find("[data-testid='playground-nav-search']").Input("");

        var trigger = cut.Find("[data-testid='nav-category-Forms']");

        Assert.Equal("false", trigger.GetAttribute("aria-expanded"));
        Assert.Equal(
            PlaygroundCatalog.Categories.Count,
            cut.FindAll("[data-testid^='nav-category-']").Count
        );
    }

    [Fact]
    public void TypingAQuery_HighlightsTheMatchingSubstringInsideMarkElement()
    {
        var cut = Render(@<PlaygroundNav />);

        cut.Find("[data-testid='playground-nav-search']").Input("utto");

        var entry = cut.Find("[data-testid='nav-entry-Button']");
        var mark = entry.QuerySelector("mark");

        Assert.NotNull(mark);
        Assert.Equal("utto", mark!.TextContent);
        Assert.Equal("Button", entry.TextContent);
    }

    [Fact]
    public void TypingAQuery_ShowsResultCountWithAriaLivePolite()
    {
        var cut = Render(@<PlaygroundNav />);

        cut.Find("[data-testid='playground-nav-search']").Input("witch");

        var count = cut.Find("[data-testid='playground-nav-result-count']");

        Assert.Equal("polite", count.GetAttribute("aria-live"));
        Assert.Equal("1 component", count.TextContent.Trim());
    }

    [Fact]
    public void TypingANonMatchingQuery_RendersEmptyState()
    {
        var cut = Render(@<PlaygroundNav />);

        cut.Find("[data-testid='playground-nav-search']").Input("zzz-no-match");

        var empty = cut.Find("[data-testid='playground-nav-empty']");

        Assert.Equal("No components match \"zzz-no-match\".", empty.TextContent.Trim());
        Assert.Empty(cut.FindAll("[data-testid^='nav-entry-']"));
    }

    [Fact]
    public void WithNoQuery_ResultCountAreaIsBlank()
    {
        var cut = Render(@<PlaygroundNav />);

        var count = cut.Find("[data-testid='playground-nav-result-count']");

        Assert.Equal("", count.TextContent.Trim());
    }

    [Fact]
    public void FirstRender_ActivatesShortcutModule_Once()
    {
        Render(@<PlaygroundNav />);

        Assert.Single(ActivateShortcut.Invocations);
    }

    [Fact]
    public async Task DisposeAsync_DeactivatesShortcutModule()
    {
        Render(@<PlaygroundNav />);

        await DisposeComponentsAsync();

        Assert.Single(DeactivateShortcut.Invocations);
    }
}
