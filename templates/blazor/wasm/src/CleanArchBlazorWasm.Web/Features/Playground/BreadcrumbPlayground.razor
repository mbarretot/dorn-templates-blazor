@page "/playground/breadcrumb"
@layout PlaygroundLayout

<PageTitle>Playground · Breadcrumb</PageTitle>

<ComponentPlayground
    Title="Breadcrumb"
    Description="Pure composition — Breadcrumb, BreadcrumbList, BreadcrumbItem, BreadcrumbLink, BreadcrumbPage, and BreadcrumbSeparator carry no bindable root parameters of their own."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <p class="text-sm text-muted-foreground">Breadcrumb has no bindable parameters — this composition is static.</p>
    </Controls>
    <Preview>
        <Breadcrumb>
            <BreadcrumbList>
                <BreadcrumbItem>
                    <BreadcrumbLink Href="/">Home</BreadcrumbLink>
                </BreadcrumbItem>
                <BreadcrumbSeparator />
                <BreadcrumbItem>
                    <BreadcrumbLink Href="/library">Library</BreadcrumbLink>
                </BreadcrumbItem>
                <BreadcrumbSeparator />
                <BreadcrumbItem>
                    <BreadcrumbLink Href="/library/data">Data</BreadcrumbLink>
                </BreadcrumbItem>
                <BreadcrumbSeparator />
                <BreadcrumbItem>
                    <BreadcrumbPage>Overview</BreadcrumbPage>
                </BreadcrumbItem>
            </BreadcrumbList>
        </Breadcrumb>
    </Preview>
</ComponentPlayground>

