    [Fact]
    public void WithAmbientEditContext_SetsAriaInvalid_WhenValidationFails()
    {
        SetupOpenInterop(AnchorModule, DismissModule);
        var model = new TestModel();
        var editContext = new EditContext(model);

        var cut = Render(
            @<CascadingValue Value="@editContext" IsFixed="true">
                <Select
                    TValue="string"
                    Value="@model.Theme"
                    ValueChanged="@(v => model.Theme = v)"
                    ValueExpression="@(() => model.Theme)"
                >
                    <SelectItem TValue="string" Value="@("light")">Light</SelectItem>
                </Select>
            </CascadingValue>
        );

        var messageStore = new ValidationMessageStore(editContext);
        messageStore.Add(editContext.Field(nameof(TestModel.Theme)), "Theme is required.");
        cut.InvokeAsync(editContext.NotifyValidationStateChanged);

        Assert.Equal("true", cut.Find("[role=combobox]").GetAttribute("aria-invalid"));
    }

    private sealed class TestModel
    {
        public string Theme { get; set; } = "";
    }
}
