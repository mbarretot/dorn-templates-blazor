<div class="flex flex-col gap-1.5" data-testid="@($"control-{Label}")">
    <span class="text-sm font-medium text-foreground">@Label</span>
    <Input Value="Value" ValueChanged="HandleChangedAsync" ValueExpression="() => Value" aria-label="@Label" />
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private Task HandleChangedAsync(string value) => ValueChanged.InvokeAsync(value);
}
