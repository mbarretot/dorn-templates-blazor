<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>Dorn.Templates.BlazorWasm</PackageId>
        <Title>Dorn Blazor WebAssembly Template</Title>
        <Authors>Dorn Contributors</Authors>
        <Description>Blazor WebAssembly app with MudBlazor and Aspire orchestration. Install via `dotnet new install Dorn.Templates.BlazorWasm`.</Description>
        <PackageTags>dotnet-new;templates;blazor;webassembly;mudblazor;design-system</PackageTags>
        <PackageProjectUrl>https://github.com/mbarretot/dorn-templates-blazor</PackageProjectUrl>
        <RepositoryUrl>https://github.com/mbarretot/dorn-templates-blazor.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageIcon>dorn-icon.jpg</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TargetFramework>netstandard2.0</TargetFramework>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageOutputPath>$(MSBuildThisFileDirectory)../../../artifacts</PackageOutputPath>
        <PackageVersion Condition="'$(PackageVersion)'==''">0.0.1-local</PackageVersion>
    </PropertyGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="../assets/dorn-icon.jpg" Pack="true" PackagePath="\" />
        <Content
            Include="../../../templates/blazor/wasm/**/*"
            Exclude="../../../templates/blazor/wasm/**/bin/**;../../../templates/blazor/wasm/**/obj/**;../../../templates/blazor/wasm/**/TestResults/**;../../../templates/blazor/wasm/**/*.user"
            PackagePath="content/"
        />
    </ItemGroup>
</Project>
