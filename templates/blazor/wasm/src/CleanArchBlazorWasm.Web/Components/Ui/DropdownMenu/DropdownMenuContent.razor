@implements IAsyncDisposable
<div
    @ref="_element"
    id="@Context.ContentId"
    role="menu"
    aria-labelledby="@Context.TriggerId"
    popover="manual"
    class="@ComputedClass"
    @onkeydown="OnKeyDownAsync"
    @onkeydown:stopPropagation="true"
    @attributes="AdditionalAttributes"
>
    @ChildContent
</div>

@code {
    private const string BaseClass =
        "z-50 min-w-[8rem] overflow-hidden rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md";

    private ElementReference _element;
    private DotNetObjectReference<DropdownMenuContent>? _dotNetRef;
    private bool _pendingOpen;
    private bool _pendingClose;
    private bool _wasOpen;

    [CascadingParameter]
    private DropdownMenuContext Context { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Side { get; set; } = "bottom";

    [Parameter]
    public string? Align { get; set; } = "start";

    [Parameter]
    public double Offset { get; set; } = 4;

    [Parameter]
    public double CollisionPadding { get; set; } = 8;

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject]
    private AnchorInterop AnchorInterop { get; set; } = default!;

    [Inject]
    private DismissInterop DismissInterop { get; set; } = default!;

    private string ComputedClass => Cn.Merge(BaseClass, Class);

    protected override void OnParametersSet()
    {
        if (Context is null)
        {
            throw new InvalidOperationException(
                "DropdownMenuContent must be rendered inside a <DropdownMenu>."
            );
        }

        if (Context.IsOpen && !_wasOpen)
        {
            _pendingOpen = true;
        }
        else if (!Context.IsOpen && _wasOpen)
        {
            _pendingClose = true;
        }

        _wasOpen = Context.IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
        }

        if (_pendingOpen && !_element.Equals(default(ElementReference)))
        {
            _pendingOpen = false;
            Context.PresentationClosed = false;
            Context.ClosePresentation = ClosePresentationAsync;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await AnchorInterop.ShowAsync(_element);
            await AnchorInterop.PositionAsync(
                Context.TriggerElement,
                _element,
                Side ?? "bottom",
                Align ?? "start",
                Offset,
                CollisionPadding
            );
            await DismissInterop.ActivateAsync(Context.ContentId, _element, _dotNetRef);
            await Context.FocusActiveItemAsync();
        }
        else if (_pendingClose)
        {
            _pendingClose = false;
            if (!Context.PresentationClosed)
            {
                await ClosePresentationAsync();
            }
            if (Context.RestoreTriggerOnClose)
            {
                await Context.FocusTriggerAsync();
            }
        }
    }

    [JSInvokable]
    public Task RequestDismissAsync() =>
        Context.Parent is null ? Context.CloseChainAsync() : Context.CloseCurrentAsync(true);

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        e.Key is "Escape" or "ArrowLeft" && Context.Parent is not null
            ? Context.CloseCurrentAsync(true)
            : Task.CompletedTask;

    private async Task ClosePresentationAsync()
    {
        await DismissInterop.DeactivateAsync(Context.ContentId);
        await AnchorInterop.DisposeAsync(_element);
        await AnchorInterop.HideAsync(_element);
        Context.PresentationClosed = true;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (Context.IsOpen)
            {
                await DismissInterop.DeactivateAsync(Context.ContentId);
                await AnchorInterop.DisposeAsync(_element);
            }
        }
        catch (JSDisconnectedException)
        {
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }
}
