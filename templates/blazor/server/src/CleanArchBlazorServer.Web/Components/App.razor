<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CleanArchBlazorServer</title>
    <base href="/" />
    <!-- Classic script, no type="module"/defer/async: must run synchronously before first
         paint so the resolved light/dark mode is known before Blazor's own first render. -->
    <script src="@Assets["theme-boot.js"]"></script>
    <!-- @Assets fingerprints the URL; a literal href would silently drop fingerprinting. -->
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/brand-font.css"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>
