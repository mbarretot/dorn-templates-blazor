@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void TogglingOpenControl_OpensMenu_AndCallsAnchorShow()
    {
        var show = AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();

        var cut = Render(@<DropdownMenuPlayground />);

        cut.Find("[data-testid='control-Open'] button").Click();

        Assert.Single(show.Invocations);
    }

    [Fact]
    public void ClickingItem_UpdatesLastAction()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();

        var cut = Render(@<DropdownMenuPlayground />);

        cut.Find("[data-testid='control-Open'] button").Click();
        cut.Find("[role=menuitem]").Click();

        Assert.Contains("Last action: Edit", cut.Find("[data-testid=playground-preview]").TextContent);
    }
}
