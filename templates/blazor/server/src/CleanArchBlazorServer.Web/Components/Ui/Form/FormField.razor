<CascadingValue Value="_context" IsFixed="true">
    <div class="@Cn.Merge("flex flex-col gap-1.5", Class)">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private FieldContext _context = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    protected override void OnInitialized()
    {
        _context = new FieldContext { Id = UiId.New("field"), NotifyStateChanged = StateHasChanged };
    }
}
