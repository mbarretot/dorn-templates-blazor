{
  "$schema": "http://json.schemastore.org/template",
  "author": "Dorn Contributors",
  "classifications": ["Blazor", "WebAssembly", "Design System"],
  "identity": "Dorn.Templates.BlazorWasm",
  "name": "Dorn Blazor WebAssembly App",
  "description": "Front-end-only Blazor WebAssembly app with MudBlazor and Aspire orchestration.",
  "shortName": "dorn-blazor-wasm",
  "preferNameDirectory": true,
  "sourceName": "CleanArchBlazorWasm",
  "symbols": {
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the xUnit test projects (added in a later template slice)."
    },
    "IncludeAspire": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include .NET Aspire orchestration: an AppHost project that registers the WebAssembly front-end as a resource. Off by default: the generated app runs as a plain Blazor WebAssembly app."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!IncludeTests)",
          "exclude": ["tests/**"]
        },
        {
          "condition": "(!IncludeAspire)",
          "exclude": ["src/CleanArchBlazorWasm.AppHost/**"]
        }
      ]
    }
  ],
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["<!--#if"],
            "else": ["<!--#else"],
            "elseif": ["<!--#elseif"],
            "endif": ["<!--#endif"],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  },
  "primaryOutputs": [
    {
      "path": "CleanArchBlazorWasm.slnx"
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ],
  "tags": {
    "language": "C#",
    "type": "project"
  }
}
