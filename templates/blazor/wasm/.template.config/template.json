{
  "$schema": "http://json.schemastore.org/template",
  "author": "Dorn Contributors",
  "classifications": ["Blazor", "WebAssembly", "Design System"],
  "identity": "Dorn.Templates.BlazorWasm",
  "name": "Dorn Blazor WebAssembly App",
  "description": "Front-end-only Blazor WebAssembly app with MudBlazor and Aspire orchestration.",
  "shortName": "dorn-blazor-wasm",
  "preferNameDirectory": true,
  "sourceName": "CleanArchBlazorWasm",
  "symbols": {
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the xUnit test projects (added in a later template slice)."
    },
    "IncludeAspire": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include .NET Aspire orchestration: an AppHost project that registers the WebAssembly front-end as a resource. Off by default: the generated app runs as a plain Blazor WebAssembly app."
    },
    "IncludeCleanArchitecture": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include Clean Architecture class libraries: {App}.Domain, {App}.Application, and {App}.Infrastructure, wired to {App}.Web by project reference. Off by default: features stay vertical slices under Features/{Name}/, which remains the top-level shape either way."
    },
    "Palette": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        {
          "choice": "Terracotta",
          "description": "Warm rust, olive and gold on a cream surface. Default palette."
        },
        {
          "choice": "Ocean",
          "description": "Teal and marine blue, calm and nautical."
        },
        {
          "choice": "Forest",
          "description": "Deep green, walnut brown and moss gold."
        },
        {
          "choice": "Sunset",
          "description": "Coral, plum magenta and amber."
        },
        {
          "choice": "Lavender",
          "description": "Violet, dusty rose and slate blue."
        },
        {
          "choice": "Slate",
          "description": "Steel blue-gray with a cyan accent."
        },
        {
          "choice": "Citrus",
          "description": "Tangerine, lime green and sunflower yellow."
        }
      ],
      "defaultValue": "Terracotta",
      "description": "Choose the MudBlazor color palette applied to the generated app's light and dark themes."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!IncludeTests)",
          "exclude": ["tests/**"]
        },
        {
          "condition": "(!IncludeAspire)",
          "exclude": ["src/CleanArchBlazorWasm.AppHost/**"]
        },
        {
          "condition": "(!IncludeCleanArchitecture)",
          "exclude": [
            "src/CleanArchBlazorWasm.Domain/**",
            "src/CleanArchBlazorWasm.Application/**",
            "src/CleanArchBlazorWasm.Infrastructure/**",
            "src/CleanArchBlazorWasm.Web/Features/ToDo/**",
            "tests/CleanArchBlazorWasm.Application.Tests/Architecture/**",
            "tests/CleanArchBlazorWasm.Application.Tests/ToDos/**",
            "tests/CleanArchBlazorWasm.Functional.Tests/Features/ToDo/**"
          ]
        }
      ]
    }
  ],
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["<!--#if"],
            "else": ["<!--#else"],
            "elseif": ["<!--#elseif"],
            "endif": ["<!--#endif"],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    },
    "**/AppTheme.cs": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["//#if"],
            "else": ["//#else"],
            "elseif": ["//#elseif"],
            "endif": ["//#endif"],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  },
  "primaryOutputs": [
    {
      "path": "CleanArchBlazorWasm.slnx"
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ],
  "tags": {
    "language": "C#",
    "type": "project"
  }
}
