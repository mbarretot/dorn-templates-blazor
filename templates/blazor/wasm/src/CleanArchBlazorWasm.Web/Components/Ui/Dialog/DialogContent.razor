@implements IAsyncDisposable
<dialog
    @ref="_dialogElement"
    class="@ComputedClass"
    aria-labelledby="@Context.TitleId"
    aria-describedby="@Context.DescriptionId"
    @attributes="AdditionalAttributes"
>
    @ChildContent
</dialog>

@code {
    private const string BaseClass =
        "fixed inset-0 m-auto max-h-[calc(100vh-2rem)] w-full max-w-lg overflow-auto rounded-lg border border-border bg-background p-6 text-foreground shadow-lg backdrop:bg-black/50";

    private ElementReference _dialogElement;
    private DotNetObjectReference<DialogContent>? _dotNetRef;
    private bool _pendingOpen;
    private bool _pendingClose;
    private bool _wasOpen;

    [CascadingParameter]
    private DialogContext Context { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? InitialFocus { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject]
    private ModalInterop ModalInterop { get; set; } = default!;

    private string ComputedClass => Cn.Merge(BaseClass, Class);

    protected override void OnParametersSet()
    {
        if (Context is null)
        {
            throw new InvalidOperationException("DialogContent must be rendered inside a <Dialog>.");
        }

        if (Context.IsOpen && !_wasOpen)
        {
            _pendingOpen = true;
        }
        else if (!Context.IsOpen && _wasOpen)
        {
            _pendingClose = true;
        }

        _wasOpen = Context.IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Design C9: no IJSRuntime call may occur before the <dialog> element exists in the DOM.
        if (_pendingOpen && !_dialogElement.Equals(default(ElementReference)))
        {
            _pendingOpen = false;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await ModalInterop.OpenAsync(_dialogElement, _dotNetRef, InitialFocus);
        }
        else if (_pendingClose)
        {
            _pendingClose = false;
            await ModalInterop.CloseAsync(_dialogElement);
        }
    }

    /// <summary>
    /// The single entry point every platform-driven dismissal reaches (design: the native
    /// `cancel` event on Escape, and a backdrop click — see <c>ui-modal.js</c>). Routes through
    /// the same <see cref="DialogContext.RequestClose"/> path a close-button click uses, so
    /// <c>OnOpenChange</c> fires exactly once regardless of dismissal source.
    /// </summary>
    [JSInvokable]
    public Task RequestDismissAsync() => Context.RequestClose();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (Context.IsOpen)
            {
                await ModalInterop.CloseAsync(_dialogElement);
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit/module already gone — nothing left to clean up JS-side.
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }
}
