@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Components.Layout
@using CleanArchBlazorServer.Web.Components.Theme
@using CleanArchBlazorServer.Web.Components.Ui.Toast
@using Dorn.WebUI.Primitives.Theme
@using Dorn.WebUI.Primitives.Toast
@using Microsoft.Extensions.DependencyInjection
@using Xunit

@code {
    public ToastTests()
    {
        Services.AddSingleton(new ToastStore());
        Services.AddScoped<ThemeInterop>();
        Services.AddScoped<ThemeState>();
    }

    [Fact]
    public async Task ToastHost_RendersAccessibleToast_AndDismissesIt()
    {
        var store = Services.GetRequiredService<ToastStore>();
        var cut = Render<ToastHost>();

        store.Publish(new ToastRequest("Saved", "Your changes were stored."));

        cut.WaitForAssertion(() =>
        {
            var toast = cut.Find("[data-testid='toast-item']");
            Assert.Equal("status", toast.GetAttribute("role"));
            Assert.Equal("Saved", toast.QuerySelector("[data-testid='toast-title']")?.TextContent);
            Assert.Equal(
                "Your changes were stored.",
                toast.QuerySelector("[data-testid='toast-description']")?.TextContent
            );
        });

        await cut.InvokeAsync(() => cut.Find("[data-testid='toast-close']").Click());

        cut.WaitForAssertion(() => Assert.Empty(cut.FindAll("[data-testid='toast-item']")));
    }

    [Fact]
    public async Task ToastHost_RendersAssertiveAction_AndRemovesItAfterInvocation()
    {
        var store = Services.GetRequiredService<ToastStore>();
        var invoked = false;
        var cut = Render<ToastHost>();

        store.Publish(
            new ToastRequest(
                "Undo deletion",
                Action: new ToastActionDescriptor(
                    "Undo",
                    () =>
                    {
                        invoked = true;
                        return Task.CompletedTask;
                    }
                ),
                Assertive: true
            )
        );

        cut.WaitForAssertion(() =>
        {
            Assert.Equal("alert", cut.Find("[data-testid='toast-item']").GetAttribute("role"));
            Assert.Equal("Undo", cut.Find("[data-testid='toast-action']").TextContent);
        });

        await cut.InvokeAsync(() => cut.Find("[data-testid='toast-action']").Click());

        cut.WaitForAssertion(() =>
        {
            Assert.True(invoked);
            Assert.Empty(cut.FindAll("[data-testid='toast-item']"));
        });
    }

    [Fact]
    public void ToastHost_ExpiresToast_WithoutRemovingTheLiveRegion()
    {
        var store = Services.GetRequiredService<ToastStore>();
        var cut = Render<ToastHost>();

        store.Publish(new ToastRequest("Saved", Duration: TimeSpan.FromMilliseconds(10)));

        cut.WaitForAssertion(() =>
        {
            Assert.Empty(cut.FindAll("[data-testid='toast-item']"));
            Assert.Equal("polite", cut.Find("[data-testid='toast-viewport']").GetAttribute("aria-live"));
        }, TimeSpan.FromSeconds(2));
    }

    [Fact]
    public async Task ToastHost_Disposal_UnsubscribesBeforeLaterNotifications()
    {
        var store = Services.GetRequiredService<ToastStore>();
        var cut = Render<ToastHost>();
        var renderCount = cut.RenderCount;

        cut.Dispose();
        store.Publish(new ToastRequest("Saved"));
        await Task.Delay(20);

        Assert.Equal(renderCount, cut.RenderCount);
    }

    [Fact]
    public void MainLayout_RendersToastHost()
    {
        JSInterop
            .Setup<ThemeSnapshot>("dornTheme.getSnapshot")
            .SetResult(new ThemeSnapshot("slate", "light", false));

        var main = Render<MainLayout>();

        Assert.Single(main.FindAll("[data-testid='toast-viewport']"));
    }

    [Fact]
    public async Task ToastStore_IsScopedPerCircuit()
    {
        var services = new ServiceCollection();
        services.AddScoped<ToastStore>();
        await using var provider = services.BuildServiceProvider();
        await using var firstScope = provider.CreateAsyncScope();
        await using var secondScope = provider.CreateAsyncScope();
        var first = firstScope.ServiceProvider.GetRequiredService<ToastStore>();
        var second = secondScope.ServiceProvider.GetRequiredService<ToastStore>();

        first.Publish(new ToastRequest("Private"));

        Assert.NotSame(first, second);
        Assert.Empty(second.Items);
    }
}
