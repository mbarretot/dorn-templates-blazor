@implements IAsyncDisposable
<div
    @ref="_element"
    id="@Context.ContentId"
    role="dialog"
    tabindex="-1"
    popover="manual"
    class="@ComputedClass"
    @attributes="AdditionalAttributes"
>
    @ChildContent
</div>

@code {
    private const string BaseClass =
        "z-50 w-72 rounded-md border border-border bg-popover p-4 text-popover-foreground shadow-md outline-none";

    private ElementReference _element;
    private DotNetObjectReference<PopoverContent>? _dotNetRef;
    private bool _pendingOpen;
    private bool _pendingClose;
    private bool _wasOpen;

    [CascadingParameter]
    private PopoverContext Context { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    [Inject]
    private AnchorInterop AnchorInterop { get; set; } = default!;

    [Inject]
    private DismissInterop DismissInterop { get; set; } = default!;

    private string ComputedClass => Cn.Merge(BaseClass, Class);

    protected override void OnParametersSet()
    {
        if (Context is null)
        {
            throw new InvalidOperationException(
                "PopoverContent must be rendered inside a <Popover>."
            );
        }

        if (Context.IsOpen && !_wasOpen)
        {
            _pendingOpen = true;
        }
        else if (!Context.IsOpen && _wasOpen)
        {
            _pendingClose = true;
        }

        _wasOpen = Context.IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingOpen && !_element.Equals(default(ElementReference)))
        {
            _pendingOpen = false;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await AnchorInterop.ShowAsync(_element);
            await AnchorInterop.PositionAsync(
                Context.TriggerElement,
                _element,
                Context.Side,
                Context.Align,
                Context.Offset,
                Context.CollisionPadding
            );
            await DismissInterop.ActivateAsync(Context.ContentId, _element, _dotNetRef);
            await _element.FocusAsync();
        }
        else if (_pendingClose)
        {
            _pendingClose = false;
            await DismissInterop.DeactivateAsync(Context.ContentId);
            await AnchorInterop.DisposeAsync(_element);
            await AnchorInterop.HideAsync(_element);
            await Context.FocusTriggerAsync();
        }
    }

    [JSInvokable]
    public Task RequestDismissAsync() => Context.RequestClose();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (Context.IsOpen)
            {
                await DismissInterop.DeactivateAsync(Context.ContentId);
                await AnchorInterop.DisposeAsync(_element);
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit/module already gone — nothing left to clean up JS-side.
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }
}
