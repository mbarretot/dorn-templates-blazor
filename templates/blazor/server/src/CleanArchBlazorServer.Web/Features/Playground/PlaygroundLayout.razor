@layout MainLayout
@inherits LayoutComponentBase
@using CleanArchBlazorServer.Web.Components.Ui.Dialog

<div class="flex flex-1">
    <div class="flex flex-1 flex-col">
        <div class="border-b border-border p-4 lg:hidden">
            <Dialog @bind-Open="_navOpen">
                <DialogTrigger
                    Class="rounded-md border border-border p-2 text-foreground lg:hidden"
                    aria-label="Open navigation"
                    aria-controls="playground-nav-drawer"
                    data-testid="playground-nav-drawer-trigger"
                >
                    <span aria-hidden="true">☰</span>
                </DialogTrigger>
                <DialogContent
                    Class="m-0 h-full w-72 rounded-none p-4"
                    InitialFocus="[data-playground-search]"
                    id="playground-nav-drawer"
                    data-testid="playground-nav-drawer"
                >
                    <DialogHeader>
                        <DialogTitle>Playground</DialogTitle>
                    </DialogHeader>
                    <PlaygroundNav />
                </DialogContent>
            </Dialog>
        </div>
        <div id="playground-main" class="flex-1">
            @Body
        </div>
    </div>
    <aside
        class="hidden w-64 shrink-0 flex-col gap-4 border-l border-border p-4 lg:flex"
        aria-label="Playground component catalog"
    >
        <a href="/playground" class="font-semibold text-foreground">Playground</a>
        <PlaygroundNav />
    </aside>
</div>

@code {
    private bool _navOpen;
}
