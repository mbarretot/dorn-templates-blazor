@page "/playground/alert"
@layout PlaygroundLayout

<PageTitle>Playground · Alert</PageTitle>

<ComponentPlayground
    Title="Alert"
    Description="Destructive and Warning render role=alert; Default and Success render role=status."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <EnumControl TEnum="AlertVariant" Label="Variant" @bind-Value="_variant" />
    </Controls>
    <Preview>
        <Alert Variant="_variant">
            <AlertTitle>Heads up</AlertTitle>
            <AlertDescription>This alert reflects the selected variant's semantic status token.</AlertDescription>
        </Alert>
    </Preview>
</ComponentPlayground>

@code {
    private AlertVariant _variant = AlertVariant.Default;

    private string CodeSnippet
    {
        get
        {
            var attributes = _variant != AlertVariant.Default ? $" Variant=\"AlertVariant.{_variant}\"" : "";
            return $"""
                <Alert{attributes}>
                    <AlertTitle>Heads up</AlertTitle>
                    <AlertDescription>...</AlertDescription>
                </Alert>
                """;
        }
    }

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new(
            "Variant",
            "AlertVariant",
            "Default",
            "Visual style variant; Destructive/Warning render role=\"alert\", Default/Success render role=\"status\"."
        ),
    ];
}
