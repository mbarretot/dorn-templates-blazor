<button
    type="button"
    class="rounded-md px-2 py-1 text-sm font-medium text-primary underline-offset-4 hover:underline focus:outline-none focus:ring-2 focus:ring-ring"
    data-testid="toast-action"
    @onclick="OnClick"
>
    @Label
</button>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public EventCallback OnClick { get; set; }
}
