@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Features.Home
@using Xunit

@code {
    [Fact]
    public void Home_ExposesObservatoryContextAndPlaygroundPath()
    {
        var cut = Render(@<Home />);

        Assert.Equal("Component Observatory", cut.Find("h1").TextContent.Trim());
        Assert.Equal("Open Playground", cut.Find("a[href='/playground']").TextContent.Trim());
        Assert.Contains("Live specimen", cut.Find("[aria-label='Live specimen']").TextContent);
    }

    [Fact]
    public void LiveSpecimen_WhenUnavailable_RetainsPlaygroundPath()
    {
        var cut = Render(@<LiveSpecimen IsAvailable="false" />);

        Assert.Equal("alert", cut.Find("[role='alert']").GetAttribute("role"));
        Assert.Equal("Open Playground", cut.Find("a[href='/playground']").TextContent.Trim());
    }

    [Fact]
    public void ObservatoryHero_ProvidesNamedLiveAndPlaygroundNavigation()
    {
        var cut = Render(@<ObservatoryHero />);

        Assert.Equal("Observatory navigation", cut.Find("nav").GetAttribute("aria-label"));
        Assert.Equal("Live specimen", cut.Find("a[href='#live-specimen']").TextContent.Trim());
        Assert.Equal("Open Playground", cut.Find("a[href='/playground']").TextContent.Trim());
    }
}
