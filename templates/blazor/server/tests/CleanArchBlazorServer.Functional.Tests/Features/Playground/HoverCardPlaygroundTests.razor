@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Features.Playground
@using Xunit

@code {
    // Deliberately does not open the HoverCard: OpenDelay/CloseDelay's live-controlled values are
    // asserted directly, avoiding real-delay-timer-dependent assertions (known CI flake surface).
    [Fact]
    public void ChangingDelayControls_UpdatesDisplayedDelays_WithoutOpeningOrTouchingInterop()
    {
        var cut = Render(@<HoverCardPlayground />);

        Assert.Contains("OpenDelay: 600ms", cut.Find("[data-testid=playground-preview]").TextContent);
        Assert.Contains("CloseDelay: 300ms", cut.Find("[data-testid=playground-preview]").TextContent);

        cut.Find("[data-testid='control-OpenDelay'] input").Input("900");
        cut.Find("[data-testid='control-CloseDelay'] input").Input("700");

        Assert.Contains("OpenDelay: 900ms", cut.Find("[data-testid=playground-preview]").TextContent);
        Assert.Contains("CloseDelay: 700ms", cut.Find("[data-testid=playground-preview]").TextContent);
        Assert.Empty(AnchorModule.Invocations);
        Assert.Empty(DismissModule.Invocations);
    }
}
