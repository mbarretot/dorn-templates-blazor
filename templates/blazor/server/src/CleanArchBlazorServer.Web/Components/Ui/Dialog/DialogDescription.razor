<p id="@Context.DescriptionId" class="@Cn.Merge("text-sm text-muted-foreground", Class)">
    @ChildContent
</p>

@code {
    [CascadingParameter]
    private DialogContext Context { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    protected override void OnParametersSet()
    {
        if (Context is null)
        {
            throw new InvalidOperationException(
                "DialogDescription must be rendered inside a <Dialog>."
            );
        }
    }
}
