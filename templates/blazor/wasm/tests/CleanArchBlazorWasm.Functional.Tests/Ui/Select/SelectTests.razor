    {
        SetupOpenInterop(AnchorModule, DismissModule);
        var value = "light";

        var cut = Render<Select<string>>(parameters =>
            parameters
                .Add(p => p.Value, value)
                .Add(p => p.ValueChanged, EventCallback.Factory.Create<string>(this, v => value = v))
                .Add(p => p.ValueExpression, () => value)
                .AddChildContent(builder =>
                {
                    builder.OpenComponent<SelectItem<string>>(0);
                    builder.AddAttribute(1, "Value", "light");
                    builder.AddAttribute(2, "data-testid", "option-light");
                    builder.AddAttribute(3, "ChildContent", (RenderFragment)(b => b.AddContent(0, "Light")));
                    builder.CloseComponent();

                    builder.OpenComponent<SelectItem<string>>(4);
                    builder.AddAttribute(5, "Value", "dark");
                    builder.AddAttribute(6, "data-testid", "option-dark");
                    builder.AddAttribute(7, "ChildContent", (RenderFragment)(b => b.AddContent(0, "Dark")));
                    builder.CloseComponent();
                })
        );

        cut.Find("[role=combobox]").Click();
        cut.Find("[data-testid=option-dark]").KeyDown(new KeyboardEventArgs { Key = "Escape" });

        Assert.Equal("light", value);
        Assert.Equal("false", cut.Find("[role=combobox]").GetAttribute("aria-expanded"));
    }

