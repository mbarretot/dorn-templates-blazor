@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Components.Ui.DropdownMenu
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Xunit

@code {
    [Fact]
    public void ArrowRight_OpensTheChildMenu_AndActivatesItAfterTheRoot()
    {
        var activate = SetupInterop();
        var cut = Render(BuildMenu());

        cut.Find("[data-testid=sub-trigger]").KeyDown(new KeyboardEventArgs { Key = "ArrowRight" });

        Assert.Equal("true", cut.Find("[data-testid=sub-trigger]").GetAttribute("aria-expanded"));
        Assert.Equal(2, cut.FindAll("[role=menu]").Count);
        Assert.Equal(2, activate.Invocations.Count);
    }

    [Theory]
    [InlineData("Escape")]
    [InlineData("ArrowLeft")]
    public void ReturnKeys_CloseOnlyTheChildMenu_AndKeepTheRootOpen(string key)
    {
        SetupInterop();
        var deactivate = DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();
        var cut = Render(BuildMenu());
        cut.Find("[data-testid=sub-trigger]").KeyDown(new KeyboardEventArgs { Key = "ArrowRight" });

        cut.FindAll("[role=menu]")[1].KeyDown(new KeyboardEventArgs { Key = key });

        Assert.Equal("true", cut.Find("[data-testid=root-trigger]").GetAttribute("aria-expanded"));
        Assert.Equal("false", cut.Find("[data-testid=sub-trigger]").GetAttribute("aria-expanded"));
        Assert.Single(deactivate.Invocations);
    }

    [Fact]
    public void TerminalItem_ClosesTheFullChain_AndRestoresTheRootTriggerOnce()
    {
        SetupInterop();
        var deactivate = DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();
        var cut = Render(BuildMenu());
        cut.Find("[data-testid=sub-trigger]").KeyDown(new KeyboardEventArgs { Key = "ArrowRight" });
        var rootContentId = cut.Find("[data-testid=root-trigger]").GetAttribute("aria-controls");
        var childContentId = cut.Find("[data-testid=sub-trigger]").GetAttribute("aria-controls");
        var focusCount = JSInterop.Invocations.Count(invocation =>
            invocation.Identifier == "Blazor._internal.domWrapper.focus"
        );

        cut.Find("[data-testid=terminal]").Click();

        Assert.Equal("false", cut.Find("[data-testid=root-trigger]").GetAttribute("aria-expanded"));
        Assert.Equal("false", cut.Find("[data-testid=sub-trigger]").GetAttribute("aria-expanded"));
        Assert.Equal(2, deactivate.Invocations.Count);
        var deactivations = deactivate.Invocations.ToArray();
        Assert.Equal(childContentId, deactivations[0].Arguments[0]);
        Assert.Equal(rootContentId, deactivations[1].Arguments[0]);
        Assert.Equal(
            focusCount + 1,
            JSInterop.Invocations.Count(invocation =>
                invocation.Identifier == "Blazor._internal.domWrapper.focus"
            )
        );
    }

    private JSRuntimeInvocationHandler SetupInterop()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();
        return DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
    }

    private static RenderFragment BuildMenu() =>
        @<DropdownMenu DefaultOpen="true">
            <DropdownMenuTrigger data-testid="root-trigger">Root</DropdownMenuTrigger>
            <DropdownMenuContent>
                <DropdownMenuSub>
                    <DropdownMenuSubTrigger data-testid="sub-trigger">More</DropdownMenuSubTrigger>
                    <DropdownMenuSubContent>
                        <DropdownMenuItem data-testid="terminal">Terminal</DropdownMenuItem>
                    </DropdownMenuSubContent>
                </DropdownMenuSub>
            </DropdownMenuContent>
        </DropdownMenu>;
}
