@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void TogglingOpenControl_OpensDialog_AndCallsModalOpen()
    {
        var open = ModalModule.SetupVoid("open", _ => true).SetVoidResult();

        var cut = Render(@<DialogPlayground />);

        cut.Find("[data-testid='control-Open'] button").Click();

        Assert.Single(open.Invocations);
    }
}
