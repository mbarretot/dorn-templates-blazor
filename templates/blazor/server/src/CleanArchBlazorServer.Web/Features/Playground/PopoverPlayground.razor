@page "/playground/popover"
@layout PlaygroundLayout

<PageTitle>Playground · Popover</PageTitle>

<ComponentPlayground
    Title="Popover"
    Description="Opens on trigger click, Enter, or Space. Focus moves into the content on open and returns to the trigger on close; dismisses on an outside pointerdown, Escape, or PopoverClose."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <BoolControl Label="Open" @bind-Value="_open" />
    </Controls>
    <Preview>
        <Popover @bind-Open="_open">
            <PopoverTrigger Class="@Button.ResolveClass(ButtonVariant.Outline, ButtonSize.Default, null)">
                Open popover
            </PopoverTrigger>
            <PopoverContent>
                <div class="flex flex-col gap-2">
                    <p class="text-sm font-medium text-foreground">Dimensions</p>
                    <p class="text-sm text-muted-foreground">Set the dimensions for the layer.</p>
                    <PopoverClose
                        Class="@(Button.ResolveClass(ButtonVariant.Outline, ButtonSize.Sm, null) + " self-end")"
                        data-testid="popover-close"
                    >
                        Close
                    </PopoverClose>
                </div>
            </PopoverContent>
        </Popover>
    </Preview>
</ComponentPlayground>

@code {
    private bool _open;

    private string CodeSnippet => $"<Popover{(_open ? " Open=\"true\"" : "")}>...</Popover>";

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Open", "bool", "false", "Controls the open state (two-way bindable)."),
        new("OpenChanged", "EventCallback<bool>", "-", "Fires when the open state changes."),
        new("DefaultOpen", "bool", "false", "Initial open state when uncontrolled."),
        new("Side", "string", "\"bottom\"", "Preferred side to anchor the content."),
        new("Align", "string", "\"center\"", "Alignment along the anchored side."),
        new("Offset", "double", "4", "Distance in pixels between the trigger and content."),
        new("CollisionPadding", "double", "8", "Minimum viewport padding kept during collision avoidance."),
    ];
}
