@page "/playground/avatar"
@layout PlaygroundLayout

<PageTitle>Playground · Avatar</PageTitle>

<ComponentPlayground
    Title="Avatar"
    Description="AvatarImage flips to AvatarFallback on load failure, in the same fixed-size box — no layout shift. Shown here side-by-side: a working image and a deliberately broken one."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <EnumControl TEnum="AvatarSize" Label="Size" @bind-Value="_size" />
    </Controls>
    <Preview>
        <div class="flex items-center gap-6">
            <Avatar Size="_size">
                <AvatarImage Src="https://github.com/shadcn.png" Alt="Working avatar" />
                <AvatarFallback>CN</AvatarFallback>
            </Avatar>
            <Avatar Size="_size">
                <AvatarImage Src="https://broken.invalid/missing.png" Alt="Broken avatar" />
                <AvatarFallback>JD</AvatarFallback>
            </Avatar>
        </div>
    </Preview>
</ComponentPlayground>

@code {
    private AvatarSize _size = AvatarSize.Default;

    private string CodeSnippet
    {
        get
        {
            var attributes = _size != AvatarSize.Default ? $" Size=\"AvatarSize.{_size}\"" : "";
            return $"""
                <Avatar{attributes}>
                    <AvatarImage Src="https://github.com/shadcn.png" Alt="..." />
                    <AvatarFallback>CN</AvatarFallback>
                </Avatar>
                """;
        }
    }

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Size", "AvatarSize", "Default", "Avatar diameter preset."),
        new("Src", "string?", "null", "AvatarImage's image URL."),
        new("Alt", "string?", "null", "AvatarImage's alt text."),
    ];
}
