@page "/playground/separator"
@layout PlaygroundLayout

<PageTitle>Playground · Separator</PageTitle>

<ComponentPlayground
    Title="Separator"
    Description="Orientation switches both the ARIA orientation and the layout direction of the two sections it divides."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <EnumControl TEnum="SeparatorOrientation" Label="Orientation" @bind-Value="_orientation" />
        <BoolControl Label="Decorative" @bind-Value="_decorative" />
    </Controls>
    <Preview>
        <div class="@(_orientation == SeparatorOrientation.Horizontal ? "flex flex-col gap-4" : "flex h-24 flex-row items-center gap-4")">
            <div class="text-sm text-foreground">Section A</div>
            <Separator
                Orientation="_orientation"
                Decorative="_decorative"
                Class="@(_orientation == SeparatorOrientation.Vertical ? "h-full" : "")"
            />
            <div class="text-sm text-foreground">Section B</div>
        </div>
    </Preview>
</ComponentPlayground>

@code {
    private SeparatorOrientation _orientation = SeparatorOrientation.Horizontal;
    private bool _decorative;

    private string CodeSnippet
    {
        get
        {
            var attributes = "";
            attributes +=
                _orientation != SeparatorOrientation.Horizontal
                    ? $" Orientation=\"SeparatorOrientation.{_orientation}\""
                    : "";
            attributes += _decorative ? " Decorative=\"true\"" : "";
            return $"<Separator{attributes} />";
        }
    }

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Orientation", "SeparatorOrientation", "Horizontal", "Horizontal or vertical separator."),
        new(
            "Decorative",
            "bool",
            "false",
            "Marks the separator as decorative (role=\"none\"), hiding it from assistive tech."
        ),
    ];
}
