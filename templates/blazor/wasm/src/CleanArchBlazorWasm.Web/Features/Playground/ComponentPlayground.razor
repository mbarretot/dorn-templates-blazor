<div id="playground-workbench" class="mx-auto flex max-w-6xl flex-col gap-8 p-6 sm:p-8">
    <div class="flex flex-col gap-1">
        <p class="text-sm font-medium uppercase tracking-[0.2em] text-primary">Component Observatory</p>
        <h1 class="text-3xl font-bold text-foreground">@Title</h1>
        @if (Description is not null)
        {
            <p class="text-muted-foreground">@Description</p>
        }
    </div>

    <nav
        class="flex flex-wrap gap-2 rounded-lg border border-border bg-card p-3 text-sm"
        aria-label="Workbench regions"
        data-testid="playground-region-navigation"
    >
        <a class="rounded-md px-3 py-2 text-foreground hover:bg-accent" href="#playground-preview">Preview</a>
        <a class="rounded-md px-3 py-2 text-foreground hover:bg-accent" href="#playground-controls">Controls</a>
        <a class="rounded-md px-3 py-2 text-foreground hover:bg-accent" href="#playground-inspector">Inspector</a>
        <a class="rounded-md px-3 py-2 text-foreground hover:bg-accent" href="#playground-code">Code</a>
        <a class="rounded-md px-3 py-2 text-foreground hover:bg-accent" href="#playground-api">API</a>
    </nav>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <section
            id="playground-preview"
            class="flex min-w-0 flex-col gap-4 rounded-lg border border-border bg-card p-6"
            aria-label="Preview"
            data-testid="playground-preview"
        >
            <h2 class="text-lg font-semibold text-foreground">Preview</h2>
            <div class="flex min-h-32 items-center">@Preview</div>
        </section>
        <div class="flex min-w-0 flex-col gap-6">
            <section
                id="playground-controls"
                class="flex flex-col gap-4"
                aria-label="Controls"
                data-testid="playground-controls"
            >
                <h2 class="text-lg font-semibold text-foreground">Controls</h2>
                @Controls
            </section>
            <PlaygroundInspector
                Title="@Title"
                CodeSnippet="@CodeSnippet"
                ApiParameters="@ApiParameters"
            />
        </div>
    </div>

    <PlaygroundSection Id="playground-code" TestId="playground-code" Title="Code">
        <div class="relative">
            <pre class="overflow-x-auto rounded-md border border-border bg-muted p-4 text-sm text-foreground"><code>@CodeSnippet</code></pre>
            <CopyButton Text="@CodeSnippet" Class="absolute right-2 top-2" />
        </div>
    </PlaygroundSection>

    <PlaygroundSection Id="playground-api" TestId="playground-api" Title="API">
        <div class="overflow-x-auto rounded-md border border-border">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-border bg-muted/50 text-foreground">
                    <tr>
                        <th class="px-4 py-2 font-medium">Name</th>
                        <th class="px-4 py-2 font-medium">Type</th>
                        <th class="px-4 py-2 font-medium">Default</th>
                        <th class="px-4 py-2 font-medium">Description</th>
                        <th class="w-px px-4 py-2 font-medium"><span class="sr-only">Copy</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var parameter in ApiParameters)
                    {
                        <tr class="border-b border-border last:border-b-0">
                            <td class="px-4 py-2 font-mono text-xs text-foreground">@parameter.Name</td>
                            <td class="px-4 py-2 font-mono text-xs text-muted-foreground">@parameter.Type</td>
                            <td class="px-4 py-2 font-mono text-xs text-muted-foreground">@parameter.Default</td>
                            <td class="px-4 py-2 text-muted-foreground">@parameter.Description</td>
                            <td class="px-4 py-2 text-right">
                                <CopyButton
                                    Text="@($"{parameter.Name}: {parameter.Type}")"
                                    aria-label="@($"Copy {parameter.Name}")"
                                    data-testid="@($"api-copy-{parameter.Name}")"
                                />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </PlaygroundSection>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Description { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment Controls { get; set; } = default!;

    [Parameter, EditorRequired]
    public RenderFragment Preview { get; set; } = default!;

    [Parameter, EditorRequired]
    public string CodeSnippet { get; set; } = "";

    [Parameter, EditorRequired]
    public IReadOnlyList<PlaygroundParameter> ApiParameters { get; set; } = [];
}
