@typeparam TValue
@inherits UiInputBase<TValue>
@implements IAsyncDisposable
@using System.Diagnostics.CodeAnalysis

<CascadingValue Value="_context" IsFixed="true">
    <button
        type="button"
        @ref="_triggerElement"
        id="@_triggerId"
        role="combobox"
        aria-haspopup="listbox"
        aria-expanded="@(_isOpen ? "true" : "false")"
        aria-controls="@_contentId"
        aria-invalid="@(IsInvalid ? "true" : null)"
        class="@TriggerClass"
        @onclick="ToggleAsync"
        @onkeydown="OnTriggerKeyDownAsync"
        @attributes="AdditionalAttributes"
    >
        <span>@(string.IsNullOrEmpty(CurrentValueAsString) ? Placeholder : CurrentValueAsString)</span>
    </button>
    <div
        @ref="_contentElement"
        id="@_contentId"
        role="listbox"
        aria-labelledby="@_triggerId"
        popover="manual"
        class="@ContentClass"
    >
        @ChildContent
    </div>
</CascadingValue>

@code {
    private const string TriggerBaseClass =
        "flex h-9 w-full items-center justify-between rounded-md border border-input bg-background px-3 py-1 text-sm text-foreground shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50";

    private const string InvalidClass = "border-destructive focus-visible:ring-destructive";

    private const string ContentBaseClass =
        "z-50 min-w-[8rem] overflow-hidden rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md";

    private readonly string _triggerId = UiId.New("select-trigger");
    private readonly string _contentId = UiId.New("select-content");
    private ElementReference _triggerElement;
    private ElementReference _contentElement;
    private DotNetObjectReference<Select<TValue>>? _dotNetRef;
    private bool _isOpen;
    private bool _pendingOpen;
    private bool _pendingClose;
    private SelectContext<TValue> _context = default!;

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Inject]
    private AnchorInterop AnchorInterop { get; set; } = default!;

    [Inject]
    private DismissInterop DismissInterop { get; set; } = default!;

    private string TriggerClass => Cn.Merge(TriggerBaseClass, IsInvalid ? InvalidClass : null, Class);

    private string ContentClass => ContentBaseClass;

    protected override void OnInitialized()
    {
        _context = new SelectContext<TValue>
        {
            NotifyStateChanged = StateHasChanged,
            CommitValue = CommitValueAsync,
            Cancel = RequestCloseAsync,
        };
    }

    protected override void OnParametersSet() => _context.SelectedValue = CurrentValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Options only register into Context.Focus (setting the initial ActiveId) from
            // their own OnAfterRender, which runs after this render already produced
            // tabindex="-1" for every option. One extra render reflects the registered state.
            StateHasChanged();
        }

        if (_pendingOpen && !_contentElement.Equals(default(ElementReference)))
        {
            _pendingOpen = false;
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await AnchorInterop.ShowAsync(_contentElement);
            await AnchorInterop.PositionAsync(_triggerElement, _contentElement, "bottom", "start", 4, 8);
            await DismissInterop.ActivateAsync(_contentId, _contentElement, _dotNetRef);
            await _context.FocusActiveItemAsync();
        }
        else if (_pendingClose)
        {
            _pendingClose = false;
            await DismissInterop.DeactivateAsync(_contentId);
            await AnchorInterop.DisposeAsync(_contentElement);
            await AnchorInterop.HideAsync(_contentElement);
            await _triggerElement.FocusAsync();
        }
    }

    [JSInvokable]
    public Task RequestDismissAsync() => RequestCloseAsync();

    private Task ToggleAsync() => _isOpen ? RequestCloseAsync() : RequestOpenAsync();

    private Task RequestOpenAsync()
    {
        _isOpen = true;
        _pendingOpen = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task RequestCloseAsync()
    {
        _isOpen = false;
        _pendingClose = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task CommitValueAsync(TValue value)
    {
        CurrentValue = value;
        await RequestCloseAsync();
    }

    private Task OnTriggerKeyDownAsync(KeyboardEventArgs e) =>
        e.Key switch
        {
            "ArrowDown" or "ArrowUp" or "Enter" or " " when !_isOpen => RequestOpenAsync(),
            _ => Task.CompletedTask,
        };

    protected override bool TryParseValueFromString(
        string? value,
        [MaybeNullWhen(false)] out TValue result,
        [NotNullWhen(false)] out string? validationErrorMessage
    )
    {
        result = default!;
        validationErrorMessage = $"{FieldIdentifier.FieldName} does not support parsing from text.";
        return false;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_isOpen)
            {
                await DismissInterop.DeactivateAsync(_contentId);
                await AnchorInterop.DisposeAsync(_contentElement);
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit/module already gone — nothing left to clean up JS-side.
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }
}
