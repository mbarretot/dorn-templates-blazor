<CascadingValue Value="_context" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    private readonly UiValueComponent<string> _value = new();
    private TabsContext _context = default!;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string? DefaultValue { get; set; }

    [Parameter]
    public TabsOrientation Orientation { get; set; } = TabsOrientation.Horizontal;

    [Parameter]
    public TabsActivationMode ActivationMode { get; set; } = TabsActivationMode.Automatic;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        _context = new TabsContext { IdPrefix = UiId.New("tabs"), ActivateAsync = ActivateAsync };
    }

    protected override void OnParametersSet()
    {
        _value.SetParameters(Value, ValueChanged, DefaultValue);
        _context.ActiveValue = _value.CurrentValue;
        _context.Orientation = Orientation;
        _context.ActivationMode = ActivationMode;
    }

    private async Task ActivateAsync(string value)
    {
        await _value.SetValueAsync(value);
        _context.ActiveValue = _value.CurrentValue;
        StateHasChanged();
    }
}
