@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Components.Ui.Select
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@using Xunit

@code {
    private string _value = "";

    [Fact]
    public void SelectGroup_RendersAccessibleLabelWithoutAddingAnOption()
    {
        var cut = RenderGroupedSelect(includeLabel: true, label: "Theme");

        var group = cut.Find("[data-testid='select-group']");
        var label = cut.Find("[data-testid='select-label']");

        Assert.Equal("group", group.GetAttribute("role"));
        Assert.Equal(label.Id, group.GetAttribute("aria-labelledby"));
        Assert.DoesNotContain("option", group.GetAttribute("role"));
        Assert.Single(cut.FindAll("[role='option']"));
    }

    [Fact]
    public void SelectGroup_RemovesAndReplacesItsActiveLabel()
    {
        var includeLabel = true;
        var label = "Theme";
        var cut = Render<Select<string>>(parameters =>
            parameters
                .Add(parameter => parameter.Value, _value)
                .Add(
                    parameter => parameter.ValueChanged,
                    EventCallback.Factory.Create<string>(this, value => _value = value)
                )
                .Add(parameter => parameter.ValueExpression, () => _value)
                .AddChildContent(builder => AddDynamicGroup(builder, () => includeLabel, () => label))
        );
        var originalId = cut.Find("[data-testid='select-label']").Id;

        includeLabel = false;
        cut.Render();

        Assert.Null(cut.Find("[data-testid='select-group']").GetAttribute("aria-labelledby"));

        includeLabel = true;
        label = "Mode";
        cut.Render();

        var replacementId = cut.Find("[data-testid='select-label']").Id;
        Assert.NotEqual(originalId, replacementId);
        Assert.Equal(replacementId, cut.Find("[data-testid='select-group']").GetAttribute("aria-labelledby"));
    }

    [Fact]
    public void SelectGroup_KeepsItsLabelIdentityAcrossRenders()
    {
        var cut = RenderGroupedSelect(includeLabel: true, label: "Theme");
        var labelId = cut.Find("[data-testid='select-label']").Id;

        cut.Render();

        Assert.Equal(labelId, cut.Find("[data-testid='select-label']").Id);
    }

    [Fact]
    public void SelectGroup_RejectsMultipleActiveLabels()
    {
        var exception = Assert.Throws<InvalidOperationException>(() =>
            Render<Select<string>>(parameters =>
                parameters
                    .Add(parameter => parameter.Value, _value)
                    .Add(
                        parameter => parameter.ValueChanged,
                        EventCallback.Factory.Create<string>(this, value => _value = value)
                    )
                    .Add(parameter => parameter.ValueExpression, () => _value)
                    .Add(
                        parameter => parameter.ChildContent,
                        (RenderFragment)(builder =>
                        {
                            builder.OpenComponent<SelectGroup<string>>(0);
                            builder.AddAttribute(1, "ChildContent", (RenderFragment)(content =>
                            {
                                AddLabel(content, 0, "First");
                                AddLabel(content, 2, "Second");
                            }));
                            builder.CloseComponent();
                        })
                    )
            )
        );

        Assert.Contains("only one active label", exception.Message, StringComparison.OrdinalIgnoreCase);
    }

    [Fact]
    public void SelectGroup_DoesNotChangeRovingOptionRegistration()
    {
        var cut = RenderGroupedSelect(includeLabel: true, label: "Theme");

        Assert.Single(cut.FindAll("[role='group']"));
        Assert.Single(cut.FindAll("[role='option']"));
        Assert.Null(cut.Find("[role='group']").GetAttribute("tabindex"));
        Assert.Null(cut.Find("[data-testid='select-label']").GetAttribute("tabindex"));
        Assert.Equal("0", cut.Find("[role='option']").GetAttribute("tabindex"));
    }

    private IRenderedComponent<Select<string>> RenderGroupedSelect(bool includeLabel, string label) =>
        Render<Select<string>>(parameters => AddSelect(parameters, includeLabel, label));

    private void AddSelect(
        ComponentParameterCollectionBuilder<Select<string>> parameters,
        bool includeLabel,
        string label
    ) =>
        parameters
            .Add(parameter => parameter.Value, _value)
            .Add(
                parameter => parameter.ValueChanged,
                EventCallback.Factory.Create<string>(this, value => _value = value)
            )
            .Add(parameter => parameter.ValueExpression, () => _value)
            .AddChildContent(builder =>
            {
                builder.OpenComponent<SelectGroup<string>>(0);
                builder.AddAttribute(1, "data-testid", "select-group");
                builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
                {
                    if (includeLabel)
                    {
                        AddLabel(content, 0, label);
                    }

                    content.OpenComponent<SelectItem<string>>(4);
                    content.AddAttribute(5, "Value", "light");
                    content.AddAttribute(6, "ChildContent", (RenderFragment)(item => item.AddContent(0, "Light")));
                    content.CloseComponent();
                }));
                builder.CloseComponent();
            });

    private static void AddLabel(RenderTreeBuilder builder, int sequence, string content)
    {
        builder.OpenComponent<SelectLabel>(sequence);
        builder.AddAttribute(sequence + 1, "data-testid", "select-label");
        builder.AddAttribute(
            sequence + 2,
            "ChildContent",
            (RenderFragment)(label => label.AddContent(0, content))
        );
        builder.CloseComponent();
    }

    private void AddDynamicGroup(
        RenderTreeBuilder builder,
        Func<bool> includeLabel,
        Func<string> label
    )
    {
        builder.OpenComponent<SelectGroup<string>>(0);
        builder.AddAttribute(1, "data-testid", "select-group");
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(content =>
        {
            if (includeLabel())
            {
                AddLabel(content, 0, label());
            }

            content.OpenComponent<SelectItem<string>>(4);
            content.AddAttribute(5, "Value", "light");
            content.AddAttribute(6, "ChildContent", (RenderFragment)(item => item.AddContent(0, "Light")));
            content.CloseComponent();
        }));
        builder.CloseComponent();
    }
}
