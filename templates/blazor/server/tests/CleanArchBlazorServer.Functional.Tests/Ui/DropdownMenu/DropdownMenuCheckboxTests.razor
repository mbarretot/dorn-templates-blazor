@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Components.Ui.DropdownMenu
@using Microsoft.AspNetCore.Components
@using Xunit

@code {
    [Fact]
    public void UncontrolledCheckbox_TogglesAriaState_AndClosesTheMenu()
    {
        SetupInterop();
        var cut = Render(BuildMenu());

        cut.Find("[data-testid=check]").Click();

        Assert.Equal("true", cut.Find("[data-testid=check]").GetAttribute("aria-checked"));
        Assert.Equal("false", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
    }

    [Fact]
    public void ControlledCheckbox_InvokesCheckedChanged_AndPreservesItsControlledState()
    {
        SetupInterop();
        var changed = true;
        var cut = Render<DropdownMenu>(parameters =>
            parameters
                .Add(p => p.DefaultOpen, true)
                .AddChildContent(
                    @<text>
                        <DropdownMenuTrigger data-testid="trigger">Options</DropdownMenuTrigger>
                        <DropdownMenuContent>
                            <DropdownMenuCheckboxItem
                                data-testid="check"
                                Checked="true"
                                CheckedChanged="@((bool value) => changed = value)"
                            >
                                Checked
                            </DropdownMenuCheckboxItem>
                        </DropdownMenuContent>
                    </text>
                )
        );

        cut.Find("[data-testid=check]").Click();

        Assert.False(changed);
        Assert.Equal("true", cut.Find("[data-testid=check]").GetAttribute("aria-checked"));
        Assert.Equal("false", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
    }

    [Fact]
    public void DisabledCheckbox_DoesNotToggleOrClose_AndRegistersOnceForFocus()
    {
        SetupInterop();
        var cut = Render(
            @<DropdownMenu DefaultOpen="true">
                <DropdownMenuTrigger data-testid="trigger">Options</DropdownMenuTrigger>
                <DropdownMenuContent>
                    <DropdownMenuCheckboxItem data-testid="check" DefaultChecked="true" Disabled="true">
                        Disabled
                    </DropdownMenuCheckboxItem>
                    <DropdownMenuItem data-testid="item">Item</DropdownMenuItem>
                </DropdownMenuContent>
            </DropdownMenu>
        );

        cut.Find("[data-testid=check]").Click();

        Assert.Equal("true", cut.Find("[data-testid=check]").GetAttribute("aria-checked"));
        Assert.Equal("true", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
        Assert.Equal(2, cut.FindAll("[role^=menuitem]").Count);
        Assert.Equal("0", cut.Find("[data-testid=item]").GetAttribute("tabindex"));
    }

    private void SetupInterop()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();
    }

    private static RenderFragment BuildMenu() =>
        @<DropdownMenu DefaultOpen="true">
            <DropdownMenuTrigger data-testid="trigger">Options</DropdownMenuTrigger>
            <DropdownMenuContent>
                <DropdownMenuCheckboxItem data-testid="check">Enabled</DropdownMenuCheckboxItem>
            </DropdownMenuContent>
        </DropdownMenu>;
}
