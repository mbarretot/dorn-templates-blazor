@typeparam TValue

<div role="group" class="@Cn.Merge(BaseClass, Class)" @attributes="AdditionalAttributes">
    <CascadingValue Value="_context" IsFixed="true">
        @ChildContent
    </CascadingValue>
</div>

@code {
    private const string BaseClass = "inline-flex items-center justify-center gap-1 rounded-md";

    private readonly UiValueComponent<TValue> _single = new();
    private readonly UiValueComponent<IReadOnlyList<TValue>> _multiple = new();
    private ToggleGroupContext<TValue> _context = default!;

    [Parameter]
    public ToggleGroupType Type { get; set; } = ToggleGroupType.Single;

    [Parameter]
    public TValue? Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public TValue? DefaultValue { get; set; }

    [Parameter]
    public IReadOnlyList<TValue>? Values { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<TValue>> ValuesChanged { get; set; }

    [Parameter]
    public IReadOnlyList<TValue>? DefaultValues { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        _context = new ToggleGroupContext<TValue>
        {
            NotifyStateChanged = StateHasChanged,
            ToggleValueAsync = ToggleValueAsync,
        };
    }

    protected override void OnParametersSet()
    {
        _single.SetParameters(Value, ValueChanged, DefaultValue);
        _multiple.SetParameters(Values, ValuesChanged, DefaultValues ?? []);
        _context.Type = Type;
        _context.Value = _single.CurrentValue;
        _context.Values = _multiple.CurrentValue ?? [];
    }

    // Items register their initial ActiveId from their own OnAfterRender, after this one runs.
    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
        }
    }

    private async Task ToggleValueAsync(TValue value)
    {
        if (Type == ToggleGroupType.Single)
        {
            await _single.SetValueAsync(ResolveNextValue(_single.CurrentValue, value)!);
            _context.Value = _single.CurrentValue;
        }
        else
        {
            await _multiple.SetValueAsync(ResolveNextValues(_multiple.CurrentValue ?? [], value));
            _context.Values = _multiple.CurrentValue ?? [];
        }

        _context.NotifyStateChanged();
    }

    public static TValue? ResolveNextValue(TValue? current, TValue clicked) =>
        EqualityComparer<TValue>.Default.Equals(current, clicked) ? default : clicked;

    public static IReadOnlyList<TValue> ResolveNextValues(IReadOnlyList<TValue> current, TValue clicked) =>
        current.Contains(clicked)
            ? [.. current.Where(v => !EqualityComparer<TValue>.Default.Equals(v, clicked))]
            : [.. current, clicked];
}
