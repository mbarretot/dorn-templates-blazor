@inject ThemeState ThemeState
@implements IDisposable

<button
    type="button"
    class="@ButtonClass"
    aria-label="@AriaLabel"
    aria-pressed="@(IsDark ? "true" : "false")"
    data-testid="theme-mode-toggle"
    @attributes="AdditionalAttributes"
    @onclick="ToggleAsync"
>
    <Icon Name="@(IsDark ? IconName.Moon : IconName.Sun)" />
</button>

@code {
    private const string ButtonClass =
        "inline-flex size-9 items-center justify-center rounded-md border border-input bg-background text-foreground transition-colors hover:bg-accent hover:text-accent-foreground";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsDark => ThemeState.ResolvedMode == ThemeMode.Dark;

    private string AriaLabel => IsDark ? "Switch to light mode" : "Switch to dark mode";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ThemeState.Changed += OnThemeChanged;
            await ThemeState.InitializeAsync();
        }
    }

    private Task ToggleAsync() =>
        ThemeState.SetModeAsync(IsDark ? ThemeMode.Light : ThemeMode.Dark);

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
