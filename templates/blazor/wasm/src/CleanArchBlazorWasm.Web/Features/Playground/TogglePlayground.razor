@page "/playground/toggle"
@layout PlaygroundLayout

<PageTitle>Playground · Toggle</PageTitle>

<ComponentPlayground
    Title="Toggle"
    Description="Click the toggle in the preview to press it; Variant and Size only change its appearance."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <EnumControl TEnum="ToggleVariant" Label="Variant" @bind-Value="_variant" />
        <EnumControl TEnum="ToggleSize" Label="Size" @bind-Value="_size" />
        <BoolControl Label="Disabled" @bind-Value="_disabled" />
    </Controls>
    <Preview>
        <Toggle @bind-Pressed="_pressed" Variant="_variant" Size="_size" Disabled="_disabled" aria-label="Toggle bold">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6 4h8a4 4 0 0 1 0 8H6z" />
                <path d="M6 12h9a4 4 0 0 1 0 8H6z" />
            </svg>
        </Toggle>
        <p class="text-sm text-muted-foreground">Pressed: @_pressed</p>
    </Preview>
</ComponentPlayground>

@code {
    private bool _pressed;
    private ToggleVariant _variant = ToggleVariant.Default;
    private ToggleSize _size = ToggleSize.Default;
    private bool _disabled;

    private string CodeSnippet
    {
        get
        {
            var attributes = _variant != ToggleVariant.Default ? $" Variant=\"ToggleVariant.{_variant}\"" : "";
            attributes += _size != ToggleSize.Default ? $" Size=\"ToggleSize.{_size}\"" : "";
            attributes += _disabled ? " Disabled=\"true\"" : "";
            return $"<Toggle @bind-Pressed=\"_pressed\"{attributes}>...</Toggle>";
        }
    }

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Pressed", "bool", "false", "Controls the pressed state (two-way bindable)."),
        new("PressedChanged", "EventCallback<bool>", "-", "Fires when the pressed state changes."),
        new("DefaultPressed", "bool", "false", "Initial pressed state when uncontrolled."),
        new("Variant", "ToggleVariant", "Default", "Visual style variant."),
        new("Size", "ToggleSize", "Default", "Visual size variant."),
        new("Disabled", "bool", "false", "Disables interaction."),
    ];
}
