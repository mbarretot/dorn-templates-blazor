@page "/playground/badge"
@layout PlaygroundLayout

<PageTitle>Playground · Badge</PageTitle>

<ComponentPlayground
    Title="Badge"
    Description="A single-parameter component — the variant resolves to a distinct, non-conflicting class set."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <EnumControl TEnum="BadgeVariant" Label="Variant" @bind-Value="_variant" />
    </Controls>
    <Preview>
        <Badge Variant="_variant">Badge</Badge>
    </Preview>
</ComponentPlayground>

@code {
    private BadgeVariant _variant = BadgeVariant.Default;

    private string CodeSnippet =>
        _variant != BadgeVariant.Default
            ? $"<Badge Variant=\"BadgeVariant.{_variant}\">Badge</Badge>"
            : "<Badge>Badge</Badge>";

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Variant", "BadgeVariant", "Default", "Visual style variant."),
    ];
}
