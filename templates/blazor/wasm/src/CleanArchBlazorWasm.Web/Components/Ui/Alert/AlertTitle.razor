<h5 class="@ComputedClass" @attributes="AdditionalAttributes">
    @ChildContent
</h5>

@code {
    private const string BaseClass = "mb-1 font-medium leading-none tracking-tight";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => Cn.Merge(BaseClass, Class);
}
