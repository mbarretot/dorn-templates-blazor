@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void RendersComposedBreadcrumbTrail_InPreview_WithNoBindableControls()
    {
        var cut = Render(@<BreadcrumbPlayground />);

        var preview = cut.Find("[data-testid=playground-preview]");
        Assert.Contains("Home", preview.TextContent);
        Assert.Contains("Overview", preview.TextContent);
        Assert.Equal("page", cut.Find("[data-testid=playground-preview] [aria-current]").GetAttribute("aria-current"));

        Assert.Empty(cut.FindAll("[data-testid=playground-controls] button"));
    }
}
