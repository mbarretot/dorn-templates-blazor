@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Components.Ui.Button
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Xunit

@code {
    // `@onclick` inside inline `@<Tag>` bUnit fragments isn't lowered — use the parameter-builder form instead.

    [Fact]
    public void Renders_AsButtonElement_WithChildContent()
    {
        var cut = Render(@<Button>Save</Button>);

        var button = cut.Find("button");
        Assert.Equal("Save", button.TextContent);
        Assert.Equal("button", button.GetAttribute("type"));
    }

    [Fact]
    public void Click_InvokesConsumerOnClickHandler_PassedThroughAdditionalAttributes()
    {
        var clicked = false;
        var cut = Render<Button>(parameters =>
            parameters
                .AddChildContent("Save")
                .AddUnmatched(
                    "onclick",
                    EventCallback.Factory.Create<MouseEventArgs>(this, () => clicked = true)
                )
        );

        cut.Find("button").Click();

        Assert.True(clicked);
    }

    [Fact]
    public void Disabled_RendersDisabledAttribute()
    {
        var cut = Render<Button>(parameters =>
            parameters.Add(p => p.Disabled, true).AddChildContent("Save")
        );

        Assert.True(cut.Find("button").HasAttribute("disabled"));
    }

    [Fact]
    public void NotDisabled_RendersNoDisabledAttribute()
    {
        var cut = Render<Button>(parameters =>
            parameters.Add(p => p.Disabled, false).AddChildContent("Save")
        );

        Assert.False(cut.Find("button").HasAttribute("disabled"));
    }

    [Fact]
    public void AdditionalAttributes_AreSplattedOntoTheButtonElement()
    {
        var cut = Render(@<Button data-testid="save-button">Save</Button>);

        Assert.NotNull(cut.Find("[data-testid=save-button]"));
    }

    [Fact]
    public void Loading_RendersSpinnerAndDisabledAndAriaBusy()
    {
        var cut = Render<Button>(parameters =>
            parameters.Add(p => p.Loading, true).AddChildContent("Save")
        );

        var button = cut.Find("button");
        Assert.NotNull(cut.Find("svg"));
        Assert.True(button.HasAttribute("disabled"));
        Assert.Equal("true", button.GetAttribute("aria-busy"));
    }

    [Fact]
    public void Loading_SuppressesClickHandler()
    {
        var clicked = false;
        var cut = Render<Button>(parameters =>
            parameters
                .Add(p => p.Loading, true)
                .AddChildContent("Save")
                .AddUnmatched(
                    "onclick",
                    EventCallback.Factory.Create<MouseEventArgs>(this, () => clicked = true)
                )
        );

        Assert.Throws<MissingEventHandlerException>(() => cut.Find("button").Click());
        Assert.False(clicked);
    }

    [Fact]
    public void NotLoading_RendersNoSpinnerAndNoAriaBusy()
    {
        var cut = Render<Button>(parameters =>
            parameters.Add(p => p.Loading, false).AddChildContent("Save")
        );

        var button = cut.Find("button");
        Assert.Empty(cut.FindAll("svg"));
        Assert.Null(button.GetAttribute("aria-busy"));
    }
}
