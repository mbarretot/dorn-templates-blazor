@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Components.Ui.Card
@using Xunit

@code {
    [Fact]
    public void EachSuppliedFragment_RendersInItsDesignatedSlot()
    {
        var cut = Render(@<Card>
            <CardHeader>
                <CardTitle>Plan</CardTitle>
                <CardDescription>Monthly billing</CardDescription>
            </CardHeader>
            <CardContent>Unlimited projects.</CardContent>
            <CardFooter>Cancel anytime.</CardFooter>
        </Card>);

        Assert.Equal("Plan", cut.Find("h3").TextContent);
        Assert.Equal("Monthly billing", cut.Find("p").TextContent);
        Assert.Contains("Unlimited projects.", cut.Markup);
        Assert.Contains("Cancel anytime.", cut.Markup);
    }

    [Fact]
    public void OmittedFooterSlot_RendersNothing()
    {
        var cut = Render(@<Card>
            <CardHeader>
                <CardTitle>Plan</CardTitle>
            </CardHeader>
            <CardContent>Unlimited projects.</CardContent>
        </Card>);

        Assert.DoesNotContain("Cancel anytime.", cut.Markup);
    }
}
