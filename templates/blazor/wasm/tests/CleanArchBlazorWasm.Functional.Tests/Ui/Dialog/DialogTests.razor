@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Components.Ui.Dialog
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using Xunit

@code {
    // The go/no-go proof point (design C6/C7/C8/C9): native <dialog>.showModal() gives the top
    // layer, ::backdrop, document inertness (Tab/Shift+Tab cannot escape), and focus restoration
    // to the invoker on close — all for free, per the WHATWG HTML spec's dialog algorithms. bUnit
    // renders into AngleSharp with no layout engine and no top layer (design's own stated
    // Functional-tier limitation), so these tests prove the CONTRACT: Dialog calls exactly the
    // JS this design says it should, at exactly the lifecycle points design C9 requires, and
    // every dismissal source funnels through the single close path. They do not — and cannot —
    // simulate real focus movement or real scroll; that is unchanged, accepted scope (design's
    // "no automated JS-module test" gap).

    [Fact]
    public void TriggerClick_OpensDialog_AndCallsModalOpen_WithInitialFocus()
    {
        var open = ModalModule.SetupVoid("open", _ => true).SetVoidResult();

        var cut = Render(@<Dialog>
            <DialogTrigger data-testid="trigger">Open</DialogTrigger>
            <DialogContent InitialFocus="#confirm">
                <DialogTitle>Title</DialogTitle>
                <DialogDescription>Description</DialogDescription>
            </DialogContent>
        </Dialog>);

        cut.Find("[data-testid=trigger]").Click();

        var invocation = Assert.Single(open.Invocations);
        Assert.IsType<ElementReference>(invocation.Arguments[0]);
        Assert.Equal("#confirm", invocation.Arguments[2]);
    }

    [Fact]
    public void DefaultOpen_RendersOpen_AndCallsModalOpen_Once()
    {
        var open = ModalModule.SetupVoid("open", _ => true).SetVoidResult();

        Render(@<Dialog DefaultOpen="true">
            <DialogContent>
                <DialogTitle>Title</DialogTitle>
            </DialogContent>
        </Dialog>);

        Assert.Single(open.Invocations);
    }

    [Fact]
    public async Task RequestDismissAsync_ClosesDialog_AndCallsModalClose()
    {
        var open = ModalModule.SetupVoid("open", _ => true).SetVoidResult();
        var close = ModalModule.SetupVoid("close", _ => true).SetVoidResult();

        var cut = Render(@<Dialog DefaultOpen="true">
            <DialogContent>
                <DialogTitle>Title</DialogTitle>
            </DialogContent>
        </Dialog>);

        var dotNetRef = ExtractDialogContentRef(open);

        // Simulates the platform routing Escape (the native `cancel` event) OR a backdrop click
        // through ui-modal.js's callback — both dismissal sources funnel through this exact same
        // [JSInvokable] entry point (design: "OnOpenChange fires ONCE" regardless of source).
        await cut.InvokeAsync(() => dotNetRef.RequestDismissAsync());

        Assert.Single(close.Invocations);
    }

    [Fact]
    public async Task RequestDismissAsync_FiresOpenChangedExactlyOnce()
    {
        var open = ModalModule.SetupVoid("open", _ => true).SetVoidResult();
        ModalModule.SetupVoid("close", _ => true).SetVoidResult();
        var changes = new List<bool>();

        var cut = Render(@<Dialog Open="true" OpenChanged="v => changes.Add(v)">
            <DialogContent>
                <DialogTitle>Title</DialogTitle>
            </DialogContent>
        </Dialog>);

        var dotNetRef = ExtractDialogContentRef(open);

        await cut.InvokeAsync(() => dotNetRef.RequestDismissAsync());

        Assert.Equal([false], changes);
    }

    [Fact]
    public void DialogClose_Click_RequestsClose_AndCallsModalClose()
    {
        ModalModule.SetupVoid("open", _ => true).SetVoidResult();
        var close = ModalModule.SetupVoid("close", _ => true).SetVoidResult();

        var cut = Render(@<Dialog DefaultOpen="true">
            <DialogContent>
                <DialogTitle>Title</DialogTitle>
                <DialogClose data-testid="close">Close</DialogClose>
            </DialogContent>
        </Dialog>);

        cut.Find("[data-testid=close]").Click();

        Assert.Single(close.Invocations);
    }

    [Fact]
    public async Task DisposeAsync_WhileOpen_CallsModalClose()
    {
        ModalModule.SetupVoid("open", _ => true).SetVoidResult();
        var close = ModalModule.SetupVoid("close", _ => true).SetVoidResult();

        Render(@<Dialog DefaultOpen="true">
            <DialogContent>
                <DialogTitle>Title</DialogTitle>
            </DialogContent>
        </Dialog>);

        await DisposeComponentsAsync();

        Assert.Single(close.Invocations);
    }

    private static DialogContent ExtractDialogContentRef(JSRuntimeInvocationHandler openHandler)
    {
        var invocation = Assert.Single(openHandler.Invocations);
        var dotNetRef = Assert.IsType<DotNetObjectReference<DialogContent>>(invocation.Arguments[1]);
        return dotNetRef.Value;
    }
}
