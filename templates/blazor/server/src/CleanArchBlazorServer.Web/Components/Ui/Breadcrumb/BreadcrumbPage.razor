<span
    role="link"
    aria-disabled="true"
    aria-current="page"
    class="@ComputedClass"
    @attributes="AdditionalAttributes"
>
    @ChildContent
</span>

@code {
    private const string BaseClass = "font-normal text-foreground";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => Cn.Merge(BaseClass, Class);
}
