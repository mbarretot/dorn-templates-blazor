@page "/playground/collapsible"
@layout PlaygroundLayout

<PageTitle>Playground · Collapsible</PageTitle>

<ComponentPlayground
    Title="Collapsible"
    Description="Toggles a content region open or closed. Disabled suppresses the trigger without removing it from the layout."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <BoolControl Label="Open" @bind-Value="_open" />
        <BoolControl Label="Disabled" @bind-Value="_disabled" />
    </Controls>
    <Preview>
        <div class="flex w-64 flex-col gap-2">
            <Collapsible @bind-Open="_open" Disabled="_disabled">
                <CollapsibleTrigger Class="@Button.ResolveClass(ButtonVariant.Outline, ButtonSize.Default, null)">
                    Toggle content
                </CollapsibleTrigger>
                <CollapsibleContent Class="mt-2 rounded-md border border-border p-4 text-sm text-foreground">
                    <p>Blazor is a framework for building interactive client-side web UI with .NET.</p>
                    <p>Collapsible content can hold any child markup.</p>
                </CollapsibleContent>
            </Collapsible>
            <p class="text-sm text-muted-foreground">Open: @_open</p>
        </div>
    </Preview>
</ComponentPlayground>

@code {
    private bool _open;
    private bool _disabled;

    private string CodeSnippet =>
        $"<Collapsible{(_open ? " Open=\"true\"" : "")}{(_disabled ? " Disabled=\"true\"" : "")}>...</Collapsible>";

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Open", "bool", "false", "Controls the open state (two-way bindable)."),
        new("OpenChanged", "EventCallback<bool>", "-", "Fires when the open state changes."),
        new("DefaultOpen", "bool", "false", "Initial open state when uncontrolled."),
        new("Disabled", "bool", "false", "Disables the trigger."),
    ];
}
