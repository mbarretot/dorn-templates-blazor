{
  "$schema": "http://json.schemastore.org/template",
  "author": "Dorn Contributors",
  "classifications": ["Blazor", "Server", "Design System"],
  "identity": "Dorn.Templates.BlazorServer",
  "name": "Dorn Blazor Server App",
  "description": "Front-end-only Blazor Server app with Interactive Server rendering, MudBlazor, and Aspire orchestration.",
  "shortName": "dorn-blazor-server",
  "preferNameDirectory": true,
  "sourceName": "CleanArchBlazorServer",
  "symbols": {
    "IncludeTests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include the xUnit test projects (added in a later template slice)."
    },
    "IncludeAspire": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include .NET Aspire orchestration: an AppHost project and a ServiceDefaults project (OpenTelemetry, health checks, service discovery). Off by default — the generated app runs as a plain ASP.NET Core web app."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!IncludeTests)",
          "exclude": ["tests/**"]
        },
        {
          "condition": "(!IncludeAspire)",
          "exclude": [
            "src/CleanArchBlazorServer.AppHost/**",
            "src/CleanArchBlazorServer.ServiceDefaults/**"
          ]
        }
      ]
    }
  ],
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["<!--#if"],
            "else": ["<!--#else"],
            "elseif": ["<!--#elseif"],
            "endif": ["<!--#endif"],
            "trim": "true",
            "wholeLine": "true"
          }
        }
      ]
    }
  },
  "primaryOutputs": [
    {
      "path": "CleanArchBlazorServer.slnx"
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true
    }
  ],
  "tags": {
    "language": "C#",
    "type": "project"
  }
}
