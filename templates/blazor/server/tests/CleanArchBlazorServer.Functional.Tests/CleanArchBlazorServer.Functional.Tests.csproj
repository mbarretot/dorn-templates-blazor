<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CleanArchBlazorServer.Web\CleanArchBlazorServer.Web.csproj" />
<!--#if (IncludeCleanArchitecture) -->
