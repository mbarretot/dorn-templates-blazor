@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Features.Playground
@using Xunit

@code {
    private static readonly PlaygroundParameter[] Parameters =
    [
        new("variant", "string", "\"default\"", "Visual style variant."),
        new("disabled", "bool", "false", "Disables interaction."),
    ];

    [Fact]
    public void ApiTable_RendersOneCopyControlPerRow()
    {
        var cut = Render(
            @<ComponentPlayground Title="Test" CodeSnippet="<Test />" ApiParameters="Parameters">
                <Controls>
                    <div>controls</div>
                </Controls>
                <Preview>
                    <div>preview</div>
                </Preview>
            </ComponentPlayground>
        );

        Assert.NotNull(cut.Find("[data-testid='api-copy-variant']"));
        Assert.NotNull(cut.Find("[data-testid='api-copy-disabled']"));
    }

    [Fact]
    public void ClickingRowCopyControl_CopiesNameColonType()
    {
        var copy = ClipboardModule.SetupVoid("copy", _ => true).SetVoidResult();
        var cut = Render(
            @<ComponentPlayground Title="Test" CodeSnippet="<Test />" ApiParameters="Parameters">
                <Controls>
                    <div>controls</div>
                </Controls>
                <Preview>
                    <div>preview</div>
                </Preview>
            </ComponentPlayground>
        );

        cut.Find("[data-testid='api-copy-variant']").Click();

        var invocation = Assert.Single(copy.Invocations);
        Assert.Equal("variant: string", invocation.Arguments[0]);
    }

    [Fact]
    public void ClickingDifferentRowCopyControl_CopiesThatRowsNameAndType()
    {
        var copy = ClipboardModule.SetupVoid("copy", _ => true).SetVoidResult();
        var cut = Render(
            @<ComponentPlayground Title="Test" CodeSnippet="<Test />" ApiParameters="Parameters">
                <Controls>
                    <div>controls</div>
                </Controls>
                <Preview>
                    <div>preview</div>
                </Preview>
            </ComponentPlayground>
        );

        cut.Find("[data-testid='api-copy-disabled']").Click();

        var invocation = Assert.Single(copy.Invocations);
        Assert.Equal("disabled: bool", invocation.Arguments[0]);
    }

    [Fact]
    public void RowCopyControls_HaveDistinctPerRowAriaLabel()
    {
        var cut = Render(
            @<ComponentPlayground Title="Test" CodeSnippet="<Test />" ApiParameters="Parameters">
                <Controls>
                    <div>controls</div>
                </Controls>
                <Preview>
                    <div>preview</div>
                </Preview>
            </ComponentPlayground>
        );

        Assert.Equal("Copy variant", cut.Find("[data-testid='api-copy-variant']").GetAttribute("aria-label"));
        Assert.Equal("Copy disabled", cut.Find("[data-testid='api-copy-disabled']").GetAttribute("aria-label"));
    }
}
