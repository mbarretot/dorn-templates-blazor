@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void ChangingRowsControl_UpdatesPreviewTextareaRowsAttribute()
    {
        var cut = Render(@<TextareaPlayground />);

        Assert.Equal("3", cut.Find("[data-testid=playground-preview] textarea").GetAttribute("rows"));

        cut.Find("[data-testid='control-Rows'] input").Input("6");

        Assert.Equal("6", cut.Find("[data-testid=playground-preview] textarea").GetAttribute("rows"));
    }
}
