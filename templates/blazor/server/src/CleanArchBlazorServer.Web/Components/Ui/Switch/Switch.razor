@inherits UiInputBase<bool>
@using System.Diagnostics.CodeAnalysis

<button
    type="button"
    role="switch"
    id="@Context?.Id"
    class="@ComputedClass"
    aria-checked="@(CurrentValue ? "true" : "false")"
    aria-invalid="@(IsInvalid ? "true" : null)"
    aria-describedby="@(Context?.HasMessage == true ? Context.MessageId : null)"
    disabled="@Disabled"
    @onclick="ToggleAsync"
    @onkeydown="OnKeyDownAsync"
    @attributes="AdditionalAttributes"
>
    <span class="@ComputedThumbClass"></span>
</button>

@code {
    private const string BaseClass =
        "peer inline-flex h-5 w-9 shrink-0 items-center rounded-full border-2 border-transparent shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50";

    private const string CheckedClass = "bg-primary";

    private const string UncheckedClass = "bg-input";

    private const string InvalidClass = "border-destructive focus-visible:ring-destructive";

    private const string ThumbBaseClass =
        "pointer-events-none block h-4 w-4 rounded-full bg-background shadow-lg ring-0 transition-transform";

    [CascadingParameter]
    private FieldContext? Context { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private string ComputedClass =>
        Cn.Merge(
            BaseClass,
            CurrentValue ? CheckedClass : UncheckedClass,
            IsInvalid ? InvalidClass : null,
            Class
        );

    private string ComputedThumbClass =>
        Cn.Merge(ThumbBaseClass, CurrentValue ? "translate-x-4" : "translate-x-0");

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        Context?.SetField(FieldIdentifier);
    }

    private Task ToggleAsync()
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }

        CurrentValue = !CurrentValue;
        return Task.CompletedTask;
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e) => e.Key == " " ? ToggleAsync() : Task.CompletedTask;

    protected override bool TryParseValueFromString(
        string? value,
        [MaybeNullWhen(false)] out bool result,
        [NotNullWhen(false)] out string? validationErrorMessage
    )
    {
        result = value == "true";
        validationErrorMessage = null;
        return true;
    }
}
