@typeparam TValue where TValue : struct, INumber<TValue>
@using System.Globalization
@using System.Numerics

<div class="flex flex-col gap-1.5" data-testid="@($"control-{Label}")">
    <span class="text-sm font-medium text-foreground">@Label</span>
    <Input Type="number" Value="@ValueAsString" ValueChanged="HandleChangedAsync" ValueExpression="() => ValueAsString" aria-label="@Label" />
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public TValue Value { get; set; }

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    private string ValueAsString => Value.ToString(null, CultureInfo.InvariantCulture);

    private Task HandleChangedAsync(string value) =>
        TValue.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var parsed)
            ? ValueChanged.InvokeAsync(parsed)
            : Task.CompletedTask;
}
