@page "/playground/progress"
@layout PlaygroundLayout
@using System.Globalization

<PageTitle>Playground · Progress</PageTitle>

<ComponentPlayground
    Title="Progress"
    Description="Value and Max are both double — the fill width is Value/Max clamped to [0, 100]%."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <NumberControl Label="Value" @bind-Value="_value" />
        <NumberControl Label="Max" @bind-Value="_max" />
    </Controls>
    <Preview>
        <Progress Value="_value" Max="_max" Class="w-64" />
    </Preview>
</ComponentPlayground>

@code {
    private double _value = 40;
    private double _max = 100;

    private string CodeSnippet
    {
        get
        {
            var attributes = $" Value=\"{_value.ToString(CultureInfo.InvariantCulture)}\"";
            attributes += _max != 100 ? $" Max=\"{_max.ToString(CultureInfo.InvariantCulture)}\"" : "";
            return $"<Progress{attributes} />";
        }
    }

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Value", "double", "0", "Current progress value."),
        new("Max", "double", "100", "Maximum value representing 100%."),
    ];
}
