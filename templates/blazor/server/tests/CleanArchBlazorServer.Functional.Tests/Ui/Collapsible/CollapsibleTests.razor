@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Components.Ui.Collapsible
@using Xunit

@code {
    // UiTestContext's Strict JSInterop mode proves zero IJSRuntime usage: unconfigured calls throw.

    [Fact]
    public void Uncontrolled_DefaultClosed_ContentHasHiddenAttribute_TriggerAriaExpandedFalse()
    {
        var cut = Render(@<Collapsible>
            <CollapsibleTrigger data-testid="trigger">Toggle</CollapsibleTrigger>
            <CollapsibleContent data-testid="content">Details</CollapsibleContent>
        </Collapsible>);

        var trigger = cut.Find("[data-testid=trigger]");
        var content = cut.Find("[data-testid=content]");

        Assert.Equal("false", trigger.GetAttribute("aria-expanded"));
        Assert.True(content.HasAttribute("hidden"));
        Assert.Equal(content.GetAttribute("id"), trigger.GetAttribute("aria-controls"));
    }

    [Fact]
    public void Uncontrolled_DefaultOpenTrue_ContentHasNoHiddenAttribute_TriggerAriaExpandedTrue()
    {
        var cut = Render(@<Collapsible DefaultOpen="true">
            <CollapsibleTrigger data-testid="trigger">Toggle</CollapsibleTrigger>
            <CollapsibleContent data-testid="content">Details</CollapsibleContent>
        </Collapsible>);

        var trigger = cut.Find("[data-testid=trigger]");
        var content = cut.Find("[data-testid=content]");

        Assert.Equal("true", trigger.GetAttribute("aria-expanded"));
        Assert.False(content.HasAttribute("hidden"));
    }

    [Fact]
    public void Uncontrolled_ClickingTrigger_TogglesOpenState()
    {
        var cut = Render(@<Collapsible>
            <CollapsibleTrigger data-testid="trigger">Toggle</CollapsibleTrigger>
            <CollapsibleContent data-testid="content">Details</CollapsibleContent>
        </Collapsible>);

        cut.Find("[data-testid=trigger]").Click();

        var trigger = cut.Find("[data-testid=trigger]");
        var content = cut.Find("[data-testid=content]");

        Assert.Equal("true", trigger.GetAttribute("aria-expanded"));
        Assert.False(content.HasAttribute("hidden"));

        cut.Find("[data-testid=trigger]").Click();

        trigger = cut.Find("[data-testid=trigger]");
        content = cut.Find("[data-testid=content]");

        Assert.Equal("false", trigger.GetAttribute("aria-expanded"));
        Assert.True(content.HasAttribute("hidden"));
    }

    [Fact]
    public void Controlled_ClickingTrigger_RaisesOpenChanged_ButDoesNotSelfMutate()
    {
        var raised = new List<bool>();

        var cut = Render(@<Collapsible Open="false" OpenChanged="@(v => raised.Add(v))">
            <CollapsibleTrigger data-testid="trigger">Toggle</CollapsibleTrigger>
            <CollapsibleContent data-testid="content">Details</CollapsibleContent>
        </Collapsible>);

        cut.Find("[data-testid=trigger]").Click();

        Assert.Equal([true], raised);
        Assert.True(cut.Find("[data-testid=content]").HasAttribute("hidden"));
    }

    [Fact]
    public void Disabled_SuppressesClickToggle()
    {
        var cut = Render(@<Collapsible Disabled="true">
            <CollapsibleTrigger data-testid="trigger">Toggle</CollapsibleTrigger>
            <CollapsibleContent data-testid="content">Details</CollapsibleContent>
        </Collapsible>);

        cut.Find("[data-testid=trigger]").Click();

        var trigger = cut.Find("[data-testid=trigger]");
        var content = cut.Find("[data-testid=content]");

        Assert.Equal("false", trigger.GetAttribute("aria-expanded"));
        Assert.True(content.HasAttribute("hidden"));
    }
}
