@using Dorn.WebUI.Primitives.Toast

<article
    role="@(Message.Request.Assertive ? "alert" : "status")"
    class="flex items-start gap-3 rounded-lg border border-border bg-card p-4 text-card-foreground shadow-lg"
    data-testid="toast-item"
>
    <div class="flex-1">
        <h2 class="font-medium" data-testid="toast-title">@Message.Request.Title</h2>
        @if (Message.Request.Description is not null)
        {
            <p class="text-sm text-muted-foreground" data-testid="toast-description">
                @Message.Request.Description
            </p>
        }
    </div>
    @if (Message.Request.Action is not null)
    {
        <ToastAction Label="@Message.Request.Action.Label" OnClick="() => OnInvokeAction.InvokeAsync(Message.Id)" />
    }
    <ToastClose OnClick="() => OnDismiss.InvokeAsync(Message.Id)" />
</article>

@code {
    [Parameter, EditorRequired]
    public ToastMessage Message { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnDismiss { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Guid> OnInvokeAction { get; set; }
}
