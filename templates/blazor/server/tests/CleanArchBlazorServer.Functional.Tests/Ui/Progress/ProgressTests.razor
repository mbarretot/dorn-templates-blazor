@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Components.Ui.Progress
@using Xunit

@code {
    [Fact]
    public void Progress_RendersProgressbarRoleWithAriaValues()
    {
        var cut = Render<Progress>(parameters => parameters.Add(p => p.Value, 40));

        var root = cut.Find("[role=progressbar]");
        Assert.Equal("40", root.GetAttribute("aria-valuenow"));
        Assert.Equal("0", root.GetAttribute("aria-valuemin"));
        Assert.Equal("100", root.GetAttribute("aria-valuemax"));
    }

    [Fact]
    public void Progress_FillBar_WidthMatchesPercentage()
    {
        var cut = Render<Progress>(parameters =>
            parameters.Add(p => p.Value, 25).Add(p => p.Max, 50)
        );

        var fill = cut.Find("[role=progressbar] > div");
        Assert.Contains("width: 50%", fill.GetAttribute("style"));
    }

    [Fact]
    public void Progress_ValueAboveMax_ClampsFillTo100Percent()
    {
        var cut = Render<Progress>(parameters => parameters.Add(p => p.Value, 150));

        var fill = cut.Find("[role=progressbar] > div");
        Assert.Contains("width: 100%", fill.GetAttribute("style"));
    }

    [Fact]
    public void Progress_NegativeValue_ClampsFillTo0Percent()
    {
        var cut = Render<Progress>(parameters => parameters.Add(p => p.Value, -10));

        var fill = cut.Find("[role=progressbar] > div");
        Assert.Contains("width: 0%", fill.GetAttribute("style"));
    }
}
