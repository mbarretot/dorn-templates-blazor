<CascadingValue Value="_context" IsFixed="false">
    @ChildContent
</CascadingValue>

@code {
    private readonly UiValueComponent<bool> _value = new();
    private CollapsibleContext _context = default!;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    [Parameter]
    public bool DefaultOpen { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        _context = new CollapsibleContext
        {
            ContentId = UiId.New("collapsible-content"),
            ToggleAsync = ToggleAsync,
            NotifyStateChanged = StateHasChanged,
        };
    }

    protected override void OnParametersSet()
    {
        _value.SetParameters(Open, OpenChanged, DefaultOpen);
        _context.Open = _value.CurrentValue;
        _context.Disabled = Disabled;
    }

    private async Task ToggleAsync()
    {
        if (_context.Disabled)
        {
            return;
        }

        await _value.SetValueAsync(!_value.CurrentValue);
        _context.Open = _value.CurrentValue;
        _context.NotifyStateChanged();
    }
}
