@typeparam TValue
@implements IDisposable
<button
    type="button"
    role="radio"
    id="@_id"
    @ref="_element"
    tabindex="@Context.Focus.TabIndexFor(_id)"
    aria-checked="@(Context.IsSelected(Value) ? "true" : "false")"
    disabled="@Disabled"
    class="@ComputedClass"
    @onclick="HandleActivateAsync"
    @onkeydown="OnKeyDownAsync"
    @onkeydown:preventDefault="true"
    @attributes="AdditionalAttributes"
>
    @if (Context.IsSelected(Value))
    {
        <span class="h-2 w-2 rounded-full bg-current" aria-hidden="true"></span>
    }
</button>

@code {
    // preventDefault stops arrow keys from scrolling the page while moving roving focus.
    private const string BaseClass =
        "aspect-square h-4 w-4 rounded-full border border-primary text-primary shadow flex items-center justify-center focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50";

    private readonly string _id = UiId.New("radio-group-item");
    private ElementReference _element;

    [CascadingParameter]
    private RadioGroupContext<TValue> Context { get; set; } = default!;

    [Parameter, EditorRequired]
    public TValue Value { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => Cn.Merge(BaseClass, Class);

    protected override void OnParametersSet()
    {
        if (Context is null)
        {
            throw new InvalidOperationException("RadioGroupItem must be rendered inside a <RadioGroup>.");
        }
    }

    protected override void OnAfterRender(bool firstRender) => Context.RegisterItem(_id, _element, Value, Disabled);

    private Task HandleActivateAsync() =>
        Disabled ? Task.CompletedTask : Context.ActivateAsync(_id, Value);

    private Task OnKeyDownAsync(KeyboardEventArgs e) => Disabled ? Task.CompletedTask : Context.MoveAsync(e.Key);

    public void Dispose() => Context.UnregisterItem(_id);
}
