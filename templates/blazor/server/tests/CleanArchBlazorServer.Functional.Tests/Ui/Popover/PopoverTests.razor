@inherits OverlayTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Components.Ui.Popover
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Xunit

@code {
    // bUnit cannot simulate real focus (same accepted limitation as Dialog/DropdownMenu); focus assertions count one extra call on open, one more on close.

    private const string FocusIdentifier = "Blazor._internal.domWrapper.focus";

    private static RenderFragment BuildPopover() =>
        @<Popover>
            <PopoverTrigger data-testid="trigger">Open</PopoverTrigger>
            <PopoverContent data-testid="content">
                <PopoverClose data-testid="close">Close</PopoverClose>
            </PopoverContent>
        </Popover>;

    [Fact]
    public void Render_WhenClosed_MakesNoInteropCalls()
    {
        var cut = Render(BuildPopover());

        Assert.Empty(AnchorModule.Invocations);
        Assert.Empty(DismissModule.Invocations);
    }

    [Fact]
    public void Click_Opens_WithoutDelay_ShowsPositionsActivatesDismiss_AndFocusesContent()
    {
        var show = AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        var position = SetupPosition();
        var activate = DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        var focusCountBeforeOpen = FocusInvocationCount();

        var cut = Render(BuildPopover());
        cut.Find("[data-testid=trigger]").Click();

        Assert.Single(show.Invocations);
        AssertPositionedWith(position, "bottom", "center", 4, 8);
        Assert.Single(activate.Invocations);
        Assert.Equal("true", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
        Assert.Equal(focusCountBeforeOpen + 1, FocusInvocationCount());
    }

    [Fact]
    public void EnterKey_OnTrigger_Opens()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();

        var cut = Render(BuildPopover());
        cut.Find("[data-testid=trigger]").KeyDown(new KeyboardEventArgs { Key = "Enter" });

        Assert.Equal("true", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
    }

    [Fact]
    public void SpaceKey_OnTrigger_Opens()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();

        var cut = Render(BuildPopover());
        cut.Find("[data-testid=trigger]").KeyDown(new KeyboardEventArgs { Key = " " });

        Assert.Equal("true", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
    }

    [Fact]
    public async Task RequestDismissAsync_ClosesPopover_DeactivatesDismiss_AndReturnsFocusToTrigger()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        var activate = DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        var deactivate = DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();

        var cut = Render(BuildPopover());
        cut.Find("[data-testid=trigger]").Click();
        var focusCountAfterOpen = FocusInvocationCount();

        var dotNetRef = ExtractDotNetRef(activate);
        await cut.InvokeAsync(() => dotNetRef.RequestDismissAsync());

        Assert.Single(deactivate.Invocations);
        Assert.Equal("false", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
        Assert.Equal(focusCountAfterOpen + 1, FocusInvocationCount());
    }

    [Fact]
    public void PopoverCloseClick_ClosesPopover()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        var deactivate = DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();

        var cut = Render(BuildPopover());
        cut.Find("[data-testid=trigger]").Click();
        cut.Find("[data-testid=close]").Click();

        Assert.Single(deactivate.Invocations);
        Assert.Equal("false", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
    }

    [Fact]
    public void Content_HasRoleDialog_TriggerHasAriaHaspopupAndControls()
    {
        var cut = Render(BuildPopover());

        var trigger = cut.Find("[data-testid=trigger]");
        var content = cut.Find("[data-testid=content]");

        Assert.Equal("dialog", content.GetAttribute("role"));
        Assert.Equal("dialog", trigger.GetAttribute("aria-haspopup"));
        Assert.Equal(content.GetAttribute("id"), trigger.GetAttribute("aria-controls"));
    }

    private int FocusInvocationCount() =>
        JSInterop.Invocations.Count(i => i.Identifier == FocusIdentifier);

    private static PopoverContent ExtractDotNetRef(JSRuntimeInvocationHandler activateHandler)
    {
        var invocation = Assert.Single(activateHandler.Invocations);
        var dotNetRef = Assert.IsType<DotNetObjectReference<PopoverContent>>(invocation.Arguments[2]);
        return dotNetRef.Value;
    }
}
