<Project>
  <!-- Self-contained on purpose: not shared with the Dorn repo root, see Directory.Build.props. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageVersion
      Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      Version="10.0.9"
    />
    <!-- Opt-in IncludeAuth demo: AuthorizeView / AuthenticationStateProvider / [Authorize]. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sdk.BlazorWebAssembly has no ASP.NET Core shared framework, so unlike Sdk.Web,
         AddHttpClient needs this package explicitly. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dorn's own packages - resolved from a local feed during development, from NuGet.org
         for end-user installs. See nuget.config and packages/Directory.Build.props (GitVersion). -->
    <PackageVersion Include="Dorn.WebUI.Primitives" Version="1.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire orchestration (design F): AppHost registers the WASM front-end as a project
         resource. No ServiceDefaults: OpenTelemetry/health-check/service-discovery are
         server-side APIs with no meaning inside the browser sandbox. -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testing. The Application/Integration tiers landed in slice 3; Functional (bUnit) landed
         in slice 4. Architecture (ArchUnitNET) ships here, pinned to the same version grpc/webapi/
         worker already use. -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!-- net10.0-compatible per its own nuspec dependency groups; resolved live, see
         sdd/feat-blazor-ui-template apply-progress obs #241. -->
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnit" Version="0.13.3" />
  </ItemGroup>
</Project>
