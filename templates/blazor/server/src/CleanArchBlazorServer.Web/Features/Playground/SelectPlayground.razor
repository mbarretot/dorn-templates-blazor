@page "/playground/select"
@layout PlaygroundLayout

<PageTitle>Playground · Select</PageTitle>

<ComponentPlayground
    Title="Select"
    Description="Arrow/Home/End move between options; Enter/Space/Tab commit and close; Escape cancels."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <p class="text-sm text-muted-foreground">Options are fixed list items — pick one in the preview to see the bound value below.</p>
    </Controls>
    <Preview>
        <div class="flex flex-col gap-1.5">
            <Label For="color-select">Favorite color</Label>
            <Select @bind-Value="_selectedColor" Placeholder="Choose a color" id="color-select">
                <SelectGroup TValue="string" data-testid="select-group">
                    <SelectLabel data-testid="select-label">Warm</SelectLabel>
                    <SelectItem Value="@("red")" data-testid="select-item">Red</SelectItem>
                </SelectGroup>
                <SelectGroup TValue="string" data-testid="select-group">
                    <SelectLabel data-testid="select-label">Cool</SelectLabel>
                    <SelectItem Value="@("green")" data-testid="select-item">Green</SelectItem>
                </SelectGroup>
                <SelectItem Value="@("blue")" data-testid="select-item">Blue</SelectItem>
            </Select>
        </div>
        <p class="text-sm text-muted-foreground">Groups and labels are non-focusable; only SelectItem joins roving focus. Selected: @(string.IsNullOrEmpty(_selectedColor) ? "none" : _selectedColor)</p>
    </Preview>
</ComponentPlayground>

@code {
    private string _selectedColor = "";

    private const string CodeSnippet =
        """
        <Select @bind-Value="_selectedColor" Placeholder="Choose a color">
            <SelectGroup TValue="string">
                <SelectLabel>Warm</SelectLabel>
                <SelectItem Value="@("red")">Red</SelectItem>
            </SelectGroup>
            <SelectGroup TValue="string">
                <SelectLabel>Cool</SelectLabel>
                <SelectItem Value="@("green")">Green</SelectItem>
            </SelectGroup>
            <SelectItem Value="@("blue")">Blue</SelectItem>
        </Select>
        """;

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Value", "TValue", "-", "The bound selected value (two-way bindable)."),
        new("Placeholder", "string?", "null", "Text shown when no value is selected."),
        new("SelectGroup", "component", "-", "Renders role=group and associates its registered SelectLabel with aria-labelledby."),
        new("SelectLabel", "component", "-", "Labels a SelectGroup without becoming focusable; only SelectItem joins roving focus."),
    ];
}
