@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Features.Home
@using Xunit

@code {
    [Fact]
    public void Home_RendersBrandingAndHeadline()
    {
        var cut = Render(@<Home />);

        Assert.Contains("Dorn Blazor Templates", cut.Markup);
        Assert.Contains("Ready in one command.", cut.Find("h3").TextContent);
        Assert.Contains("Now make it yours.", cut.Find("h3").TextContent);
    }

    [Fact]
    public void Home_RendersGitHubCallToAction()
    {
        var cut = Render(@<Home />);

        var cta = cut.Find("a[href='https://github.com/mbarretot/dorn-templates-blazor']");
        Assert.Equal("View on GitHub", cta.TextContent.Trim());
    }

    [Fact]
    public void Home_RendersValueProps()
    {
        var cut = Render(@<Home />);

        Assert.Contains("Clean Architecture", cut.Markup);
        Assert.Contains("Server or WebAssembly", cut.Markup);
        Assert.Contains("Themed and ready", cut.Markup);
    }
}
