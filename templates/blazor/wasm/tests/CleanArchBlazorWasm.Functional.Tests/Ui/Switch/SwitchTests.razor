@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Components.Ui.Switch
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Xunit

@code {
    [Fact]
    public void RendersSwitchRole_WithAriaCheckedFalse_WhenUnchecked()
    {
        var model = new TestModel();

        var cut = Render(@<Switch
            Value="@model.Enabled"
            ValueChanged="@(v => model.Enabled = v)"
            ValueExpression="@(() => model.Enabled)"
        />);

        var button = cut.Find("button");

        Assert.Equal("switch", button.GetAttribute("role"));
        Assert.Equal("false", button.GetAttribute("aria-checked"));
    }

    [Fact]
    public void RendersAriaCheckedTrue_WhenChecked()
    {
        var model = new TestModel { Enabled = true };

        var cut = Render(@<Switch
            Value="@model.Enabled"
            ValueChanged="@(v => model.Enabled = v)"
            ValueExpression="@(() => model.Enabled)"
        />);

        Assert.Equal("true", cut.Find("button").GetAttribute("aria-checked"));
    }

    [Fact]
    public void Click_TogglesValue_Standalone()
    {
        var model = new TestModel();

        var cut = Render(@<Switch
            Value="@model.Enabled"
            ValueChanged="@(v => model.Enabled = v)"
            ValueExpression="@(() => model.Enabled)"
        />);

        cut.Find("button").Click();

        Assert.True(model.Enabled);
    }

    [Fact]
    public void SpaceKey_TogglesValue_Standalone()
    {
        var model = new TestModel();

        var cut = Render(@<Switch
            Value="@model.Enabled"
            ValueChanged="@(v => model.Enabled = v)"
            ValueExpression="@(() => model.Enabled)"
        />);

        cut.Find("button").KeyDown(new KeyboardEventArgs { Key = " " });

        Assert.True(model.Enabled);
    }

    [Fact]
    public void Disabled_SuppressesClickToggle()
    {
        var model = new TestModel();

        var cut = Render(@<Switch
            Disabled="true"
            Value="@model.Enabled"
            ValueChanged="@(v => model.Enabled = v)"
            ValueExpression="@(() => model.Enabled)"
        />);

        cut.Find("button").Click();

        Assert.False(model.Enabled);
    }

    [Fact]
    public void WithinEditForm_BindsTwoWay_AndReflectsCheckedState()
    {
        var model = new TestModel();

        var cut = Render(@<EditForm Model="@model">
            <Switch
                Value="@model.Enabled"
                ValueChanged="@(v => model.Enabled = v)"
                ValueExpression="@(() => model.Enabled)"
            />
        </EditForm>);

        cut.Find("button").Click();

        Assert.True(model.Enabled);
        Assert.Equal("true", cut.Find("button").GetAttribute("aria-checked"));
    }

    [Fact]
    public void WithinEditForm_SetsAriaInvalid_WhenValidationFails()
    {
        var model = new TestModel();
        var editContext = new EditContext(model);

        var cut = Render(@<CascadingValue Value="@editContext" IsFixed="true">
            <Switch
                Value="@model.Enabled"
                ValueChanged="@(v => model.Enabled = v)"
                ValueExpression="@(() => model.Enabled)"
            />
        </CascadingValue>);

        var messageStore = new ValidationMessageStore(editContext);
        messageStore.Add(editContext.Field(nameof(TestModel.Enabled)), "This option is required.");
        cut.InvokeAsync(editContext.NotifyValidationStateChanged);

        Assert.Equal("true", cut.Find("button").GetAttribute("aria-invalid"));
    }

    [Fact]
    public void Standalone_WithNoAmbientEditContext_HasNoAriaInvalidAttribute()
    {
        var model = new TestModel();

        var cut = Render(@<Switch
            Value="@model.Enabled"
            ValueChanged="@(v => model.Enabled = v)"
            ValueExpression="@(() => model.Enabled)"
        />);

        Assert.Null(cut.Find("button").GetAttribute("aria-invalid"));
    }

    private sealed class TestModel
    {
        public bool Enabled { get; set; }
    }
}
