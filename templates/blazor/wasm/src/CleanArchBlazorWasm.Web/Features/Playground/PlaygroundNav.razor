@implements IAsyncDisposable
@using CleanArchBlazorWasm.Web.Components.Ui.Collapsible
@using CleanArchBlazorWasm.Web.Components.Ui.Form

<div class="flex flex-col gap-2">
    <Input
        Value="@_query"
        ValueChanged="OnQueryChanged"
        ValueExpression="() => _query"
        placeholder="Search components..."
        data-testid="playground-nav-search"
        data-playground-search
    />
    <p
        class="text-xs text-muted-foreground"
        role="status"
        aria-live="polite"
        data-testid="playground-nav-result-count"
    >
        @(string.IsNullOrEmpty(_query) ? "" : $"{_matchCount} {(_matchCount == 1 ? "component" : "components")}")
    </p>
    @if (_matchCount == 0 && !string.IsNullOrEmpty(_query))
    {
        <p class="text-sm text-muted-foreground" data-testid="playground-nav-empty">
            No components match "@_query".
        </p>
    }
    @foreach (var (category, entries) in _results)
    {
        if (entries.Count == 0 && !string.IsNullOrEmpty(_query))
        {
            continue;
        }

        <Collapsible Open="@IsOpen(category.Name, entries.Count)" OpenChanged="@(open => OnCategoryToggled(category.Name, open))">
            <CollapsibleTrigger
                Class="flex w-full items-center justify-between text-sm font-medium text-foreground"
                data-testid="@($"nav-category-{category.Name}")"
            >
                @category.Name
            </CollapsibleTrigger>
            <CollapsibleContent Class="flex flex-col gap-1 py-1 pl-2">
                @foreach (var entry in entries)
                {
                    <a
                        href="@entry.Href"
                        class="text-sm text-muted-foreground hover:text-foreground"
                        data-testid="@($"nav-entry-{entry.Label}")"
                    >
                        @foreach (var segment in Highlight(entry.Label, _query))
                        {
                            if (segment.IsMatch)
                            {
                                <mark class="rounded-sm bg-accent px-0.5 text-accent-foreground">@segment.Text</mark>
                            }
                            else
                            {
                                @segment.Text
                            }
                        }
                    </a>
                }
            </CollapsibleContent>
        </Collapsible>
    }
</div>

@code {
    private sealed record LabelSegment(string Text, bool IsMatch);

    private string _query = "";
    private readonly HashSet<string> _manuallyOpen = [];
    private IReadOnlyList<(PlaygroundCategory Category, IReadOnlyList<PlaygroundEntry> Entries)> _results = [];
    private int _matchCount;

    [Inject]
    private PlaygroundShortcutInterop ShortcutInterop { get; set; } = default!;

    protected override void OnInitialized() => Recompute("");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ShortcutInterop.ActivateAsync();
        }
    }

    private void OnQueryChanged(string value) => Recompute(value);

    private void Recompute(string query)
    {
        _query = query;
        _results = PlaygroundCatalog
            .Categories.Select(c => (Category: c, Entries: Filter(c, query)))
            .ToList();
        _matchCount = _results.Sum(r => r.Entries.Count);
    }

    private void OnCategoryToggled(string categoryName, bool open)
    {
        if (open)
        {
            _manuallyOpen.Add(categoryName);
        }
        else
        {
            _manuallyOpen.Remove(categoryName);
        }
    }

    private bool IsOpen(string categoryName, int filteredCount) =>
        !string.IsNullOrEmpty(_query) && filteredCount > 0
            ? true
            : _manuallyOpen.Contains(categoryName);

    private static IReadOnlyList<PlaygroundEntry> Filter(PlaygroundCategory category, string query) =>
        string.IsNullOrEmpty(query)
            ? category.Entries
            : category.Entries.Where(e => Matches(e, query)).ToList();

    private static bool Matches(PlaygroundEntry entry, string query) =>
        entry.Label.Contains(query, StringComparison.OrdinalIgnoreCase)
        || entry.Keywords.Any(k => k.Contains(query, StringComparison.OrdinalIgnoreCase));

    private static IReadOnlyList<LabelSegment> Highlight(string label, string query)
    {
        var index = string.IsNullOrEmpty(query)
            ? -1
            : label.IndexOf(query, StringComparison.OrdinalIgnoreCase);
        if (index < 0)
        {
            return [new LabelSegment(label, false)];
        }

        List<LabelSegment> segments = [];
        if (index > 0)
        {
            segments.Add(new LabelSegment(label[..index], false));
        }

        segments.Add(new LabelSegment(label.Substring(index, query.Length), true));
        if (index + query.Length < label.Length)
        {
            segments.Add(new LabelSegment(label[(index + query.Length)..], false));
        }

        return segments;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await ShortcutInterop.DeactivateAsync();
        }
        catch (JSDisconnectedException)
        {
            // Circuit/module already gone — nothing left to clean up JS-side.
        }
    }
}
