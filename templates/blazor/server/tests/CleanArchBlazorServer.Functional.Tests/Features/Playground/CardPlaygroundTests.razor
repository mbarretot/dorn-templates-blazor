@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void RendersComposedCard_InPreview_WithNoBindableControls()
    {
        var cut = Render(@<CardPlayground />);

        var preview = cut.Find("[data-testid=playground-preview]");
        Assert.Contains("Project Alpha", preview.TextContent);
        Assert.Contains("Save", preview.TextContent);

        Assert.Empty(cut.FindAll("[data-testid=playground-controls] button"));
    }
}
