@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void ChangingValueControl_UpdatesPreviewFillWidth()
    {
        var cut = Render(@<ProgressPlayground />);

        var fill = cut.Find("[data-testid=playground-preview] [role=progressbar] > div");
        Assert.Contains("width: 40%", fill.GetAttribute("style"));

        cut.Find("[data-testid='control-Value'] input").Input("75");

        fill = cut.Find("[data-testid=playground-preview] [role=progressbar] > div");
        Assert.Contains("width: 75%", fill.GetAttribute("style"));
    }
}
