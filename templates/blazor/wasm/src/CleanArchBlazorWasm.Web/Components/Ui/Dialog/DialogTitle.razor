<h2 id="@Context.TitleId" class="@Cn.Merge("text-lg font-semibold text-foreground", Class)">
    @ChildContent
</h2>

@code {
    [CascadingParameter]
    private DialogContext Context { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    protected override void OnParametersSet()
    {
        if (Context is null)
        {
            throw new InvalidOperationException("DialogTitle must be rendered inside a <Dialog>.");
        }
    }
}
