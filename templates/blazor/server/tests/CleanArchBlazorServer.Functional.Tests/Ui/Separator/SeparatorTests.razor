@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Components.Ui.Separator
@using Xunit

@code {
    [Theory]
    [InlineData(SeparatorOrientation.Horizontal, "horizontal")]
    [InlineData(SeparatorOrientation.Vertical, "vertical")]
    public void RendersSeparatorRoleAndOrientation(SeparatorOrientation orientation, string expectedOrientation)
    {
        var cut = Render<Separator>(parameters => parameters.Add(parameter => parameter.Orientation, orientation));

        var separator = cut.Find("div");
        Assert.Equal("separator", separator.GetAttribute("role"));
        Assert.Equal(expectedOrientation, separator.GetAttribute("aria-orientation"));
    }

    [Fact]
    public void Decorative_RendersPresentationRoleWithoutOrientation()
    {
        var cut = Render<Separator>(parameters => parameters.Add(parameter => parameter.Decorative, true));

        var separator = cut.Find("div");
        Assert.Equal("none", separator.GetAttribute("role"));
        Assert.Null(separator.GetAttribute("aria-orientation"));
    }
}
