@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void SelectingOrientationControl_UpdatesPreviewSeparatorAriaOrientation()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();

        var cut = Render(@<SeparatorPlayground />);

        Assert.Equal(
            "horizontal",
            cut.Find("[data-testid=playground-preview] [role=separator]").GetAttribute("aria-orientation")
        );

        cut.Find("[data-testid='control-Orientation'] button[role=combobox]").Click();
        cut.FindAll("[role=option]").First(o => o.TextContent.Trim() == "Vertical").Click();

        Assert.Equal(
            "vertical",
            cut.Find("[data-testid=playground-preview] [role=separator]").GetAttribute("aria-orientation")
        );
    }
}
