@page "/playground/radio-group"
@layout PlaygroundLayout
@using Dorn.WebUI.Primitives

<PageTitle>Playground · RadioGroup</PageTitle>

<ComponentPlayground
    Title="RadioGroup"
    Description="Arrow keys move focus AND immediately commit the newly focused item's value — selection follows focus, unlike ToggleGroup where arrow keys only move focus."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <EnumControl TEnum="RovingFocusOrientation" Label="Orientation" @bind-Value="_orientation" />
    </Controls>
    <Preview>
        <RadioGroup TValue="string" @bind-Value="_selected" Orientation="_orientation">
            <div class="flex items-center gap-2">
                <RadioGroupItem TValue="string" Value="@("default")" id="radio-default" />
                <Label For="radio-default">Default</Label>
            </div>
            <div class="flex items-center gap-2">
                <RadioGroupItem TValue="string" Value="@("comfortable")" id="radio-comfortable" />
                <Label For="radio-comfortable">Comfortable</Label>
            </div>
            <div class="flex items-center gap-2">
                <RadioGroupItem TValue="string" Value="@("compact")" id="radio-compact" />
                <Label For="radio-compact">Compact</Label>
            </div>
        </RadioGroup>
        <p class="text-sm text-muted-foreground">Selected: @(string.IsNullOrEmpty(_selected) ? "none" : _selected)</p>
    </Preview>
</ComponentPlayground>

@code {
    private string _selected = "default";
    private RovingFocusOrientation _orientation = RovingFocusOrientation.Vertical;

    private string CodeSnippet
    {
        get
        {
            var attributes = _orientation != RovingFocusOrientation.Vertical
                ? $" Orientation=\"RovingFocusOrientation.{_orientation}\""
                : "";
            return $"<RadioGroup @bind-Value=\"_selected\"{attributes}>...</RadioGroup>";
        }
    }

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Value", "TValue", "-", "The bound selected value (two-way bindable)."),
        new("Orientation", "RovingFocusOrientation", "Vertical", "Arrow-key axis for roving focus."),
    ];
}
