@inherits LayoutComponentBase
@using CleanArchBlazorWasm.Web.Components.Theme

<div class="flex min-h-screen bg-background text-foreground">
    <a href="#main-content" class="sr-only focus:not-sr-only">Skip to content</a>
    <aside class="flex w-64 shrink-0 flex-col gap-6 border-r border-border p-4">
        <a href="/" class="grid leading-tight text-foreground">
            <span class="font-mono text-xs font-semibold tracking-[0.16em] text-muted-foreground uppercase">UI lab</span>
            <span class="text-lg font-semibold">Component Observatory</span>
        </a>
        <NavMenu />
    </aside>
    <div class="flex flex-1 flex-col">
        <header class="flex items-center justify-end gap-3 border-b border-border px-6 py-4">
            <ThemeToggle />
            <Avatar Size="AvatarSize.Sm">
                <AvatarImage Src="images/avatar-placeholder.png" Alt="Current user" />
                <AvatarFallback>US</AvatarFallback>
            </Avatar>
        </header>
        <main id="main-content" tabindex="-1" class="flex-1">
            @Body
        </main>
    </div>
    <ToastHost />
</div>
