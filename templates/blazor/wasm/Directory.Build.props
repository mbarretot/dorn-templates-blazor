<Project>
  <!-- Self-contained so generated projects build outside Dorn; MSBuild imports only the nearest props file. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Front-end only (design D8): no ORM/database/orchestrator axis, no #if directives. -->
</Project>
