<div class="flex items-center gap-2" data-testid="@($"control-{Label}")">
    <Switch Value="Value" ValueChanged="HandleChangedAsync" ValueExpression="() => Value" aria-label="@Label" />
    <span class="text-sm font-medium text-foreground">@Label</span>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    private Task HandleChangedAsync(bool value) => ValueChanged.InvokeAsync(value);
}
