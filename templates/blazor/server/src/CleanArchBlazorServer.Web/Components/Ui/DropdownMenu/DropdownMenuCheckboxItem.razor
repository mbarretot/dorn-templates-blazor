@implements IDisposable
<div
    role="menuitemcheckbox"
    id="@_id"
    @ref="_element"
    tabindex="@Context.Focus.TabIndexFor(_id)"
    aria-checked="@(_value.CurrentValue ? "true" : "false")"
    aria-disabled="@(Disabled ? "true" : null)"
    class="@ComputedClass"
    @onclick="ToggleAsync"
    @onkeydown="OnKeyDownAsync"
    @attributes="AdditionalAttributes"
>
    @ChildContent
</div>

@code {
    private const string BaseClass =
        "flex cursor-pointer select-none items-center rounded-sm px-2 py-1.5 text-sm text-foreground outline-none focus-visible:bg-accent focus-visible:text-accent-foreground aria-disabled:pointer-events-none aria-disabled:opacity-50";
    private readonly string _id = UiId.New("dropdown-checkbox");
    private readonly UiValueComponent<bool> _value = new();
    private ElementReference _element;

    [CascadingParameter]
    private DropdownMenuContext Context { get; set; } = default!;

    [Parameter]
    public bool Checked { get; set; }

    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    [Parameter]
    public bool DefaultChecked { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => Cn.Merge(BaseClass, Class);

    protected override void OnParametersSet()
    {
        if (Context is null)
        {
            throw new InvalidOperationException("DropdownMenuCheckboxItem must be rendered inside a <DropdownMenu>.");
        }

        _value.SetParameters(Checked, CheckedChanged, DefaultChecked);
    }

    protected override void OnAfterRender(bool firstRender) =>
        Context.RegisterItem(_id, _element, Disabled);

    private async Task ToggleAsync()
    {
        if (Disabled)
        {
            return;
        }

        await _value.SetValueAsync(!_value.CurrentValue);
        await Context.CloseChainAsync();
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        e.Key is "Enter" or " " ? ToggleAsync() : Context.MoveAsync(e.Key);

    public void Dispose() => Context.UnregisterItem(_id);
}
