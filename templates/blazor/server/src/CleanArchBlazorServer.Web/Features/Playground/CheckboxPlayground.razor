@page "/playground/checkbox"
@layout PlaygroundLayout

<PageTitle>Playground · Checkbox</PageTitle>

<ComponentPlayground
    Title="Checkbox"
    Description="Click the checkbox in the preview to toggle it; Space does the same when it has focus."
    CodeSnippet="@CodeSnippet"
    ApiParameters="ApiParameters"
>
    <Controls>
        <BoolControl Label="Disabled" @bind-Value="_disabled" />
    </Controls>
    <Preview>
        <div class="flex items-center gap-2">
            <Checkbox @bind-Value="_checked" Disabled="_disabled" id="terms" />
            <Label For="terms">Accept terms</Label>
        </div>
        <p class="text-sm text-muted-foreground">Checked: @_checked</p>
    </Preview>
</ComponentPlayground>

@code {
    private bool _checked;
    private bool _disabled;

    private string CodeSnippet =>
        $"<Checkbox @bind-Value=\"_checked\"{(_disabled ? " Disabled=\"true\"" : "")} />";

    private static readonly PlaygroundParameter[] ApiParameters =
    [
        new("Value", "bool", "false", "The bound checked state (two-way bindable)."),
        new("Disabled", "bool", "false", "Disables interaction."),
    ];
}
