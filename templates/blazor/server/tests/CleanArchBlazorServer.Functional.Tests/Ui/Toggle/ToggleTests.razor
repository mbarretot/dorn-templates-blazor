@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Components.Ui.Toggle
@using Xunit

@code {
    [Fact]
    public void Uncontrolled_DefaultsToAriaPressedFalse()
    {
        var cut = Render(@<Toggle data-testid="toggle">Bold</Toggle>);

        Assert.Equal("false", cut.Find("[data-testid=toggle]").GetAttribute("aria-pressed"));
    }

    [Fact]
    public void Uncontrolled_DefaultPressedTrue_RendersAriaPressedTrue()
    {
        var cut = Render(@<Toggle DefaultPressed="true" data-testid="toggle">Bold</Toggle>);

        Assert.Equal("true", cut.Find("[data-testid=toggle]").GetAttribute("aria-pressed"));
    }

    [Fact]
    public void Uncontrolled_Click_TogglesAriaPressed()
    {
        var cut = Render(@<Toggle data-testid="toggle">Bold</Toggle>);

        cut.Find("[data-testid=toggle]").Click();
        Assert.Equal("true", cut.Find("[data-testid=toggle]").GetAttribute("aria-pressed"));

        cut.Find("[data-testid=toggle]").Click();
        Assert.Equal("false", cut.Find("[data-testid=toggle]").GetAttribute("aria-pressed"));
    }

    [Fact]
    public void Controlled_Click_RaisesPressedChanged_ButDoesNotSelfMutate()
    {
        var raised = new List<bool>();

        var cut = Render(
            @<Toggle Pressed="false" PressedChanged="@(v => raised.Add(v))" data-testid="toggle">
                Bold
            </Toggle>
        );

        cut.Find("[data-testid=toggle]").Click();

        Assert.Equal([true], raised);
        Assert.Equal("false", cut.Find("[data-testid=toggle]").GetAttribute("aria-pressed"));
    }

    [Fact]
    public void Disabled_SuppressesClickToggle()
    {
        var cut = Render(@<Toggle Disabled="true" data-testid="toggle">Bold</Toggle>);

        cut.Find("[data-testid=toggle]").Click();

        Assert.Equal("false", cut.Find("[data-testid=toggle]").GetAttribute("aria-pressed"));
    }
}
