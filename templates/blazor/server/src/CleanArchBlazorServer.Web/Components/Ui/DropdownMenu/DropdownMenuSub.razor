<CascadingValue Name="DropdownMenuSub" Value="_sub" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    private DropdownMenuContext _menu = default!;
    private DropdownMenuSubContext _sub = default!;

    [CascadingParameter]
    private DropdownMenuContext Parent { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override void OnInitialized()
    {
        if (Parent is null)
        {
            throw new InvalidOperationException("DropdownMenuSub must be rendered inside a <DropdownMenu>.");
        }

        _menu = new DropdownMenuContext
        {
            Parent = Parent,
            TriggerId = UiId.New("dropdown-sub-trigger"),
            ContentId = UiId.New("dropdown-sub-content"),
            RequestOpen = OpenAsync,
            RequestClose = CloseAsync,
            NotifyStateChanged = StateHasChanged,
        };
        _sub = new DropdownMenuSubContext { Menu = _menu };
    }

    private Task OpenAsync()
    {
        _menu.IsOpen = true;
        _menu.RegisterOpen();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task CloseAsync()
    {
        _menu.IsOpen = false;
        _menu.UnregisterOpen();
        StateHasChanged();
        return Task.CompletedTask;
    }
}
