@inherits LayoutComponentBase
@using CleanArchBlazorServer.Web.Components.Theme

<div class="min-h-screen bg-background text-foreground">
    <a href="#main-content" class="sr-only focus:not-sr-only">Skip to content</a>
    <header class="border-b border-border bg-background">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4 sm:px-10">
            <a href="/" class="grid leading-tight text-foreground">
                <span class="font-mono text-xs font-semibold tracking-[0.16em] text-muted-foreground uppercase">UI lab</span>
                <span class="text-lg font-semibold">Component Observatory</span>
            </a>
            <div class="flex flex-wrap items-center gap-3">
                <NavMenu />
                <ThemeSwitcher />
            </div>
        </div>
    </header>
    <main id="main-content" tabindex="-1">
        @Body
    </main>
    <ToastHost />
</div>
