@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void RendersComposedSkeletonShapes_InPreview_WithNoBindableControls()
    {
        var cut = Render(@<SkeletonPlayground />);

        var preview = cut.Find("[data-testid=playground-preview]");
        Assert.Equal(3, preview.QuerySelectorAll("[aria-hidden='true']").Length);

        Assert.Empty(cut.FindAll("[data-testid=playground-controls] button"));
    }
}
