@inherits UiTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Components.Ui.DropdownMenu
@using Xunit

@code {
    [Fact]
    public void UncontrolledRadio_SelectsOneValue_AndCloses()
    {
        Setup();
        var cut = Render(Menu());
        cut.Find("[data-testid=b]").Click();
        Assert.Equal("false", cut.Find("[data-testid=a]").GetAttribute("aria-checked"));
        Assert.Equal("true", cut.Find("[data-testid=b]").GetAttribute("aria-checked"));
        Assert.Equal("false", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
    }

    [Fact]
    public void ControlledRadio_EmitsValue_AndDisabledDoesNotClose()
    {
        Setup();
        var value = "a";
        var cut = Render(
            @<DropdownMenu DefaultOpen="true">
                <DropdownMenuTrigger data-testid="trigger">Menu</DropdownMenuTrigger>
                <DropdownMenuContent>
                    <DropdownMenuRadioGroup TValue="string" Value="@("a")" ValueChanged="@((string next) => value = next)">
                        <DropdownMenuRadioItem TValue="string" data-testid="a" ItemValue="@("a")">A</DropdownMenuRadioItem>
                        <DropdownMenuRadioItem TValue="string" data-testid="b" ItemValue="@("b")" Disabled="true">B</DropdownMenuRadioItem>
                    </DropdownMenuRadioGroup>
                </DropdownMenuContent>
            </DropdownMenu>
        );
        cut.Find("[data-testid=b]").Click();
        Assert.Equal("a", value);
        Assert.Equal("true", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
    }

    private void Setup()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult(); AnchorModule.SetupVoid("position", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult(); AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult(); DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();
    }

    private static RenderFragment Menu() =>
        @<DropdownMenu DefaultOpen="true">
            <DropdownMenuTrigger data-testid="trigger">Menu</DropdownMenuTrigger>
            <DropdownMenuContent>
                <DropdownMenuRadioGroup TValue="string" DefaultValue="@("a")">
                    <DropdownMenuRadioItem TValue="string" data-testid="a" ItemValue="@("a")">A</DropdownMenuRadioItem>
                    <DropdownMenuRadioItem TValue="string" data-testid="b" ItemValue="@("b")">B</DropdownMenuRadioItem>
                </DropdownMenuRadioGroup>
            </DropdownMenuContent>
        </DropdownMenu>;
}
