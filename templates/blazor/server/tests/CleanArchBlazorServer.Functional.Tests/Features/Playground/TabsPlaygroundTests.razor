@inherits UiTestContext
@using Bunit
@using CleanArchBlazorServer.Web.Features.Playground
@using Xunit

@code {
    [Fact]
    public void ClickingTrigger_UpdatesActiveTab_InControlsColumn()
    {
        var cut = Render(@<TabsPlayground />);

        cut.Find("[data-testid=playground-preview] [role=tab]:nth-child(2)").Click();

        Assert.Contains("Active tab: activity", cut.Find("[data-testid=playground-controls]").TextContent);
    }
}
