@inherits LayoutComponentBase
@implements IDisposable
@using CleanArchBlazorWasm.Web.Components.Theme
@inject ThemeState ThemeState

<MudThemeProvider Theme="AppTheme.Default" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton
            Icon="@Icons.Material.Filled.Menu"
            Color="Color.Inherit"
            Edge="Edge.Start"
            aria-label="@(_drawerOpen ? "Hide navigation" : "Show navigation")"
            aria-pressed="@(_drawerOpen ? "true" : "false")"
            data-testid="nav-toggle"
            OnClick="ToggleDrawer"
        />
        <MudSpacer />
        <ThemeToggle />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Temporary">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">CleanArchBlazorWasm</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <main id="main-content" tabindex="-1">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen;
    private bool _isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ThemeState.Changed += OnThemeChanged;
            await ThemeState.InitializeAsync();
            _isDarkMode = ThemeState.ResolvedMode == ThemeMode.Dark;
            StateHasChanged();
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OnThemeChanged()
    {
        _isDarkMode = ThemeState.ResolvedMode == ThemeMode.Dark;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
