@inherits OverlayTestContext
@using Bunit
@using CleanArchBlazorWasm.Web.Components.Ui.HoverCard
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using Xunit

@code {
    // Design D4: HoverCard is not focus-stealing — focus never moves on open and never returns on close.

    private const string FocusIdentifier = "Blazor._internal.domWrapper.focus";

    private static RenderFragment BuildHoverCard(int? openDelay = null, int? closeDelay = null) =>
        @<HoverCard OpenDelay="@(openDelay ?? 600)" CloseDelay="@(closeDelay ?? 300)">
            <HoverCardTrigger data-testid="trigger">Hover me</HoverCardTrigger>
            <HoverCardContent data-testid="content">Card details</HoverCardContent>
        </HoverCard>;

    [Fact]
    public void Render_WhenClosed_MakesNoInteropCalls()
    {
        var cut = Render(BuildHoverCard());

        Assert.Empty(AnchorModule.Invocations);
        Assert.Empty(DismissModule.Invocations);
    }

    [Fact]
    public void PointerEnter_DoesNotOpenImmediately_ThenOpensAfterOpenDelay_WithoutStealingFocus()
    {
        var show = AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        var position = SetupPosition();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        var focusCountBeforeOpen = FocusInvocationCount();

        var cut = Render(BuildHoverCard(openDelay: 30));
        cut.Find("[data-testid=trigger]").PointerEnter();

        Assert.Empty(show.Invocations);

        cut.WaitForAssertion(() => Assert.Single(show.Invocations), TimeSpan.FromMilliseconds(2000));
        AssertPositionedWith(position, "bottom", "center", 4, 8);
        Assert.Equal(focusCountBeforeOpen, FocusInvocationCount());
    }

    [Fact]
    public void PointerLeaveTrigger_DoesNotCloseImmediately_ClosesAfterCloseGrace()
    {
        var show = AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        SetupPosition();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        var hide = AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();
        DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();

        var cut = Render(BuildHoverCard(openDelay: 10, closeDelay: 50));
        cut.Find("[data-testid=trigger]").PointerEnter();
        cut.WaitForAssertion(() => Assert.Single(show.Invocations), TimeSpan.FromMilliseconds(1200));

        cut.Find("[data-testid=trigger]").PointerLeave();

        Assert.Empty(hide.Invocations);
        cut.WaitForAssertion(() => Assert.Single(hide.Invocations), TimeSpan.FromMilliseconds(6000));
    }

    [Fact]
    public void PointerLeaveTrigger_ThenPointerEnterContent_CancelsCloseGrace_CardStaysOpen()
    {
        var show = AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        SetupPosition();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        var hide = AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();
        DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();

        var cut = Render(BuildHoverCard(openDelay: 10, closeDelay: 50));
        cut.Find("[data-testid=trigger]").PointerEnter();
        cut.WaitForAssertion(() => Assert.Single(show.Invocations), TimeSpan.FromMilliseconds(1200));

        cut.Find("[data-testid=trigger]").PointerLeave();
        cut.Find("[data-testid=content]").PointerEnter();

        // The close-grace timer target (50ms) must have expired by now with margin, proving the trip into the card cancelled it.
        Thread.Sleep(300);
        Assert.Empty(hide.Invocations);
        Assert.Equal("true", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
    }

    [Fact]
    public void PointerLeaveContent_AfterEnteringIt_ClosesAfterCloseGrace()
    {
        var show = AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        SetupPosition();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        var hide = AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();
        DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();

        var cut = Render(BuildHoverCard(openDelay: 10, closeDelay: 50));
        cut.Find("[data-testid=trigger]").PointerEnter();
        cut.WaitForAssertion(() => Assert.Single(show.Invocations), TimeSpan.FromMilliseconds(1200));

        cut.Find("[data-testid=trigger]").PointerLeave();
        cut.Find("[data-testid=content]").PointerEnter();
        cut.Find("[data-testid=content]").PointerLeave();

        cut.WaitForAssertion(() => Assert.Single(hide.Invocations), TimeSpan.FromMilliseconds(6000));
    }

    [Fact]
    public void FocusIn_OpensAfterDelay_FocusOut_ClosesAfterCloseGrace()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        SetupPosition();
        DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        var hide = AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();
        DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();

        var cut = Render(BuildHoverCard(openDelay: 10, closeDelay: 50));
        cut.Find("[data-testid=trigger]").FocusIn();
        cut.WaitForAssertion(
            () => Assert.Equal("true", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded")),
            TimeSpan.FromMilliseconds(1200)
        );

        cut.Find("[data-testid=trigger]").FocusOut();

        Assert.Empty(hide.Invocations);
        cut.WaitForAssertion(() => Assert.Single(hide.Invocations), TimeSpan.FromMilliseconds(6000));
    }

    [Fact]
    public async Task RequestDismissAsync_ClosesHoverCard_DeactivatesDismiss_WithoutTouchingFocus()
    {
        AnchorModule.SetupVoid("show", _ => true).SetVoidResult();
        SetupPosition();
        var activate = DismissModule.SetupVoid("activate", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("dispose", _ => true).SetVoidResult();
        AnchorModule.SetupVoid("hide", _ => true).SetVoidResult();
        var deactivate = DismissModule.SetupVoid("deactivate", _ => true).SetVoidResult();

        var cut = Render(BuildHoverCard(openDelay: 10));
        cut.Find("[data-testid=trigger]").PointerEnter();
        cut.WaitForAssertion(() => Assert.Single(activate.Invocations), TimeSpan.FromMilliseconds(1200));
        var focusCountAfterOpen = FocusInvocationCount();

        var dotNetRef = ExtractDotNetRef(activate);
        await cut.InvokeAsync(() => dotNetRef.RequestDismissAsync());

        Assert.Single(deactivate.Invocations);
        Assert.Equal("false", cut.Find("[data-testid=trigger]").GetAttribute("aria-expanded"));
        Assert.Equal(focusCountAfterOpen, FocusInvocationCount());
    }

    [Fact]
    public void Content_HasRoleDialog_TriggerHasOnlyAriaExpanded()
    {
        var cut = Render(BuildHoverCard());

        var trigger = cut.Find("[data-testid=trigger]");
        var content = cut.Find("[data-testid=content]");

        Assert.Equal("dialog", content.GetAttribute("role"));
        Assert.Equal("false", trigger.GetAttribute("aria-expanded"));
        Assert.Null(trigger.GetAttribute("aria-haspopup"));
        Assert.Null(trigger.GetAttribute("aria-controls"));
    }

    private int FocusInvocationCount() =>
        JSInterop.Invocations.Count(i => i.Identifier == FocusIdentifier);

    private static HoverCardContent ExtractDotNetRef(JSRuntimeInvocationHandler activateHandler)
    {
        var invocation = Assert.Single(activateHandler.Invocations);
        var dotNetRef = Assert.IsType<DotNetObjectReference<HoverCardContent>>(invocation.Arguments[2]);
        return dotNetRef.Value;
    }
}
