@typeparam TValue
@implements IDisposable
<button
    type="button"
    id="@_id"
    @ref="_element"
    tabindex="@Context.Focus.TabIndexFor(_id)"
    aria-pressed="@(Context.IsSelected(Value) ? "true" : "false")"
    disabled="@Disabled"
    class="@ComputedClass"
    @onclick="HandleActivateAsync"
    @onkeydown="OnKeyDownAsync"
    @onkeydown:preventDefault="true"
    @attributes="AdditionalAttributes"
>
    @ChildContent
</button>

@code {
    // preventDefault avoids double-activation from the button's native Enter/Space click default.
    private const string BaseClass =
        "inline-flex items-center justify-center gap-2 rounded-sm px-2 py-1.5 text-sm font-medium transition-colors hover:bg-muted hover:text-muted-foreground aria-pressed:bg-accent aria-pressed:text-accent-foreground disabled:pointer-events-none disabled:opacity-50";

    private readonly string _id = UiId.New("toggle-group-item");
    private ElementReference _element;

    [CascadingParameter]
    private ToggleGroupContext<TValue> Context { get; set; } = default!;

    [Parameter, EditorRequired]
    public TValue Value { get; set; } = default!;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ComputedClass => Cn.Merge(BaseClass, Class);

    protected override void OnParametersSet()
    {
        if (Context is null)
        {
            throw new InvalidOperationException(
                "ToggleGroupItem must be rendered inside a <ToggleGroup>."
            );
        }
    }

    protected override void OnAfterRender(bool firstRender) =>
        Context.RegisterItem(_id, _element, Disabled);

    private Task HandleActivateAsync() =>
        Disabled ? Task.CompletedTask : Context.ActivateAsync(Value);

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        e.Key switch
        {
            "Enter" or " " => HandleActivateAsync(),
            _ => Context.MoveAsync(e.Key),
        };

    public void Dispose() => Context.UnregisterItem(_id);
}
